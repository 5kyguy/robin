# Maintainer: sky <5kyguy@users.noreply.github.com>
pkgname=robin
pkgver=0.1.0
pkgrel=1
pkgdesc="File manager and media viewer for the R2-D2 desktop"
arch=('x86_64')
url="https://github.com/5kyguy/robin"
license=('GPL-3.0-only')
depends=('fontconfig' 'libxkbcommon')
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/robin" "$pkgdir/usr/bin/robin"
  install -Dm644 packaging/robin.desktop "$pkgdir/usr/share/applications/dev.skyguy.robin.desktop"
}
