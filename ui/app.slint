import "../assets/fonts/JetBrainsMonoNerdFont-Regular.ttf";
import "../assets/fonts/JetBrainsMonoNerdFont-Bold.ttf";
import "../assets/fonts/JetBrainsMonoNerdFont-Medium.ttf";
import { ListView } from "std-widgets.slint";

// Column x positions are computed once from the list width. Header and rows
// both call these. Name is whatever is left; the other cells do not move.
export global Columns {
    out property <length> pad: 12px;
    out property <length> icon-w: 20px;
    out property <length> name-x: 40px;
    out property <length> gutter: 16px;
    out property <length> size-w: 88px;
    out property <length> type-w: 120px;
    out property <length> mod-w: 140px;
    public pure function mod-x(row-w: length) -> length {
        row-w - pad - mod-w
    }
    public pure function type-x(row-w: length) -> length {
        mod-x(row-w) - gutter - type-w
    }
    public pure function size-x(row-w: length) -> length {
        type-x(row-w) - gutter - size-w
    }
    public pure function name-w(row-w: length) -> length {
        size-x(row-w) - gutter - name-x
    }
}

export struct RefusalLine {
    path: string,
    note: string,
    // An item's own line when several moves were refused.
    head: bool,
}

export struct Place {
    glyph: string,
    name: string,
    count: string,
    selected: bool,
    usage: float,
    level: int,
    section: int,
}

export struct Row {
    glyph: string,
    name: string,
    size: string,
    kind: string,
    modified: string,
    selected: bool,
    hovered: bool,
    hidden: bool,
    role: int,
    badge: string,
    // Cut and waiting for a paste: drawn at 50%.
    cut: bool,
    // The folder a drag is over.
    drop: bool,
    // The folder a drag is over but can't drop into (it is being dragged).
    drop-refused: bool,
}

export struct GridLine {
    n: int,
    g0: string, n0: string, r0: int, b0: string, s0: bool, h0: bool,
    g1: string, n1: string, r1: int, b1: string, s1: bool, h1: bool,
    g2: string, n2: string, r2: int, b2: string, s2: bool, h2: bool,
    g3: string, n3: string, r3: int, b3: string, s3: bool, h3: bool,
    g4: string, n4: string, r4: int, b4: string, s4: bool, h4: bool,
    g5: string, n5: string, r5: int, b5: string, s5: bool, h5: bool,
}

export struct MapCell {
    x: length,
    y: length,
    w: length,
    h: length,
    name: string,
    detail: string,
    shade: float,
}

component SideRow inherits Rectangle {
    in property <string> glyph;
    in property <string> name;
    in property <string> count;
    in property <bool> picked;
    in property <bool> rail;
    in property <length> side-row;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    in property <color> selected-bg;
    height: side-row;
    border-radius: 6px;
    background: picked ? selected-bg : transparent;
    border-width: picked ? 1px : 0px;
    border-color: accent;
    Text {
        text: glyph;
        x: 12px;
        y: 0px;
        width: 18px;
        height: parent.height;
        font-size: 14px;
        color: muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if !rail: Text {
        text: name;
        x: 38px;
        y: 0px;
        width: parent.width - 38px - 72px;
        height: parent.height;
        font-size: 12px;
        color: ink;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: elide;
    }
    if !rail: Text {
        text: count;
        x: parent.width - 8px - 64px;
        y: 0px;
        width: 64px;
        height: parent.height;
        font-size: 11px;
        color: muted;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component Tile inherits Rectangle {
    in property <string> glyph;
    in property <string> name;
    in property <int> role;
    in property <string> badge;
    in property <bool> picked;
    in property <bool> hot;
    in property <length> tile;
    in property <color> ink;
    in property <color> accent;
    in property <color> danger;
    in property <color> warning;
    in property <color> muted;
    in property <color> surface;
    in property <color> selected-bg;
    in property <color> hover-bg;
    property <bool> still: name == "dune-sunset-0412.jpg" || name == "dune-sunset-0413.jpg" || name == "speeder-run.mp4" || name == "cantina-band.heic" || name == "droid-manual.pdf" || name == "lars homestead family portrait final.jpg";
    property <string> label: name == "dune-sunset-0412.jpg" ? "dune-sunset-\n0412.jpg" : name == "dune-sunset-0413.jpg" ? "dune-sunset-\n0413.jpg" : name == "speeder-run.mp4" ? "speeder-\nrun.mp4" : name == "cantina-band.heic" ? "cantina-\nband.heic" : name == "droid-manual.pdf" ? "droid-\nmanual.pdf" : name == "holo-backup.tar.zst" ? "holo-backup.\ntar.zst" : name == "binary-sunset.flac" ? "binary-\nsunset.flac" : name == "lars homestead family portrait final.jpg" ? "lars homestead\nfamily portrait final.jpg" : name;
    width: tile;
    height: tile + 44px;
    border-radius: 6px;
    background: picked ? selected-bg : hot ? hover-bg : transparent;
    VerticalLayout {
        padding: 6px;
        alignment: center;
        Rectangle {
            width: tile - 12px;
            height: tile - 12px;
            border-radius: 4px;
            background: surface;
            if name == "dune-sunset-0412.jpg": Image { source: @image-url("../assets/thumbs/dune-sunset-0412.jpg"); width: parent.width; height: parent.height; image-fit: cover; }
            if name == "dune-sunset-0413.jpg": Image { source: @image-url("../assets/thumbs/dune-sunset-0413.jpg"); width: parent.width; height: parent.height; image-fit: cover; }
            if name == "speeder-run.mp4": Image { source: @image-url("../assets/thumbs/speeder-frame.png"); width: parent.width; height: parent.height; image-fit: cover; }
            if name == "cantina-band.heic": Image { source: @image-url("../assets/thumbs/cantina-band.png"); width: parent.width; height: parent.height; image-fit: cover; }
            if name == "droid-manual.pdf": Image { source: @image-url("../assets/thumbs/droid-manual.png"); width: parent.width; height: parent.height; image-fit: cover; }
            if name == "lars homestead family portrait final.jpg": Image { source: @image-url("../assets/thumbs/lars-homestead.jpg"); width: parent.width; height: parent.height; image-fit: cover; }
            if !still: Text {
                text: glyph;
                font-size: tile * 0.32;
                color: role == 2 ? danger : role == 3 ? warning : role == 1 ? accent : role == 4 ? muted : ink;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if badge != "": Rectangle {
                x: 4px;
                y: 4px;
                width: 44px;
                height: 14px;
                border-radius: 2px;
                background: #000000.with-alpha(0.62);
                Text { text: badge; font-size: 9px; font-weight: 600; color: #e7fbff; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Text {
            text: label;
            font-size: 12px;
            color: ink;
            horizontal-alignment: center;
            overflow: elide;
            wrap: word-wrap;
            height: 32px;
        }
    }
}

component JobRow inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> detail;
    in property <float> amount;
    in property <bool> failed;
    in property <color> ink;
    in property <color> muted-ink;
    in property <color> accent-ink;
    in property <color> danger-ink;
    in property <length> row-h: 44px;
    // Live jobs show a Cancel link instead of the pause and close glyphs.
    in property <bool> cancel-link: false;
    callback cancel();
    height: row-h;
    property <length> btn: 28px;
    property <length> action-w: failed ? 112px : btn * 2 + 2px;
    property <length> action-x: self.width - 8px - action-w;
    property <length> stats-w: 228px;
    property <length> stats-x: action-x - 8px - stats-w;
    property <length> label-w: 280px;
    property <length> bar-x: 40px + label-w + 12px;
    Text {
        text: glyph;
        x: 12px;
        y: 0px;
        width: 20px;
        height: parent.height;
        font-size: 16px;
        color: failed ? danger-ink : accent-ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        text: label;
        x: 40px;
        y: 0px;
        width: label-w;
        height: parent.height;
        font-size: 12px;
        color: ink;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: bar-x;
        y: (parent.height - 4px) / 2;
        width: max(stats-x - 12px - bar-x, 200px);
        height: 4px;
        border-radius: 2px;
        background: ink.with-alpha(0.12);
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * amount;
            height: parent.height;
            border-radius: 2px;
            background: failed ? danger-ink : accent-ink;
        }
    }
    Text {
        text: detail;
        x: stats-x;
        y: 0px;
        width: stats-w;
        height: parent.height;
        font-size: 11px;
        color: muted-ink;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
    if cancel-link: Text {
        text: "Cancel";
        x: action-x;
        y: 0px;
        width: action-w;
        height: parent.height;
        font-size: 12px;
        color: accent-ink;
        horizontal-alignment: right;
        vertical-alignment: center;
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.cancel(); }
        }
    }
    if !failed && !cancel-link: Rectangle {
        x: action-x;
        y: (parent.height - btn) / 2;
        width: btn;
        height: btn;
        border-radius: 3px;
        Text {
            text: "󰏤";
            font-size: 14px;
            color: ink;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if !failed && !cancel-link: Rectangle {
        x: action-x + btn + 2px;
        y: (parent.height - btn) / 2;
        width: btn;
        height: btn;
        border-radius: 3px;
        Text {
            text: "󰅖";
            font-size: 14px;
            color: ink;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if failed: Text {
        text: "Retry";
        x: action-x;
        y: 0px;
        width: 56px;
        height: parent.height;
        font-size: 11px;
        color: ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if failed: Text {
        text: "Skip";
        x: action-x + 56px;
        y: 0px;
        width: 56px;
        height: parent.height;
        font-size: 11px;
        color: muted-ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component FilmTile inherits Rectangle {
    in property <image> shot;
    in property <bool> current;
    in property <color> ring;
    width: 72px;
    height: 48px;
    border-radius: 3px;
    border-width: current ? 2px : 0px;
    border-color: ring;
    Image {
        source: shot;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
        opacity: current ? 1 : 0.62;
    }
    if current: Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 3px;
        border-width: 2px;
        border-color: ring;
    }
}

component MetaRow inherits Rectangle {
    in property <string> key;
    in property <string> value;
    in property <color> ink;
    in property <color> muted-ink;
    height: 20px;
    Text {
        text: key;
        x: 0px;
        y: 0px;
        width: 120px;
        height: parent.height;
        font-size: 12px;
        color: muted-ink;
        horizontal-alignment: left;
        vertical-alignment: center;
    }
    Text {
        text: value;
        x: 120px;
        y: 0px;
        width: parent.width - 120px;
        height: parent.height;
        font-size: 12px;
        color: ink;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
}

component TypeRow inherits Rectangle {
    in property <string> name;
    in property <string> count;
    in property <string> size;
    in property <color> ink;
    in property <color> muted-ink;
    in property <color> swatch;
    height: 22px;
    Rectangle {
        x: 0px;
        y: 6px;
        width: 10px;
        height: 10px;
        border-radius: 2px;
        background: swatch;
    }
    Text {
        text: name;
        x: 18px;
        y: 0px;
        width: 88px;
        height: parent.height;
        font-size: 12px;
        color: ink;
        vertical-alignment: center;
    }
    Text {
        text: count;
        x: parent.width - 148px;
        y: 0px;
        width: 70px;
        height: parent.height;
        font-size: 12px;
        color: muted-ink;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    Text {
        text: size;
        x: parent.width - 72px;
        y: 0px;
        width: 72px;
        height: parent.height;
        font-size: 12px;
        color: ink;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Track with the fill pinned to the left edge. A width-only child is centred.
component Meter inherits Rectangle {
    in property <float> amount;
    in property <color> fill;
    in property <color> track;
    background: track;
    border-radius: 4px;
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * amount;
        height: parent.height;
        border-radius: 4px;
        background: fill;
    }
}

// A list column header: click to sort, again to reverse. The sorted
// column is accented and carries the direction arrow.
component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <int> column;
    in property <bool> sorted;
    in property <bool> desc;
    in property <bool> align-right;
    in property <color> accent;
    in property <color> muted;
    callback clicked();
    y: 0px;
    Text {
        text: root.sorted ? (root.align-right ? (root.desc ? "󰁅  " : "󰁝  ") + root.label : root.label + (root.desc ? "  󰁅" : "  󰁝")) : root.label;
        width: parent.width;
        height: parent.height;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        color: root.sorted ? root.accent : root.muted;
        horizontal-alignment: root.align-right ? right : left;
        vertical-alignment: center;
        overflow: elide;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    property <length> row-h: compact ? 24px : 30px;
    in property <bool> harness: true;
    in property <color> bg: #061216;
    in property <color> surface: #0e1e26;
    in property <color> text: #e7fbff;
    in property <color> muted: #7ec8d4;
    in property <color> accent: #00e5ff;
    in property <color> on-accent: #042028;
    in property <color> line: #1e6a78;
    in property <color> danger: #ff2a4a;
    in property <color> on-danger: #fff5f6;
    in property <color> warning: #ffb000;
    in property <color> on-warning: #1a1200;
    in property <string> label: "Robin";
    in property <bool> compact: false;
    in property <bool> grid: false;
    in property <bool> collapsed: false;
    in property <length> tile: 152px;
    in property <string> state: "files";
    in property <string> overlay: "";
    in property <string> viewer: "";
    in property <string> stats-mode: "";
    in property <[MapCell]> map-cells;
    in property <string> status-left: "15 items · 1 hidden";
    in property <string> status-right: "812 GB free of 1.8 TB";
    in property <bool> hidden-on: false;
    in property <string> crumbs: "~  ›  Pictures";
    in property <string> path-text: "/home/sky/Pictures";
    in property <string> search-query: "";
    in property <string> search-count: "";
    in property <string> dialog-title: "";
    in property <string> dialog-body: "";
    in property <[Place]> places;
    in property <[Place]> pinned-places;
    in property <[Place]> device-places;
    in property <[Place]> trash-places;
    in property <[Row]> files;
    // The sorted list column (0 Name, 1 Size, 2 Type, 3 Modified).
    in property <int> sort-column: 0;
    in property <bool> sort-desc: false;
    callback sort-by(int);
    // Scroll offsets, kept across live refreshes and reset on navigation.
    in-out property <length> list-scroll: 0px;
    in-out property <length> grid-scroll: 0px;
    in property <[GridLine]> grid-rows;
    in property <[string]> menu-labels;
    in property <string> toast-text: "";
    in property <[string]> toast-details;
    in property <string> toast-pin: "";
    in property <int> toast-more: 0;
    in property <bool> toast-expanded: false;
    // "" neutral, "warning" partial move, "danger" refused up front.
    in property <string> toast-tone: "";
    // Set from Rust by `app::toast_glyph`.
    in property <string> toast-glyph: "󰄬";
    in property <string> refusal-title;
    in property <[RefusalLine]> refusal-lines;
    // False when a folder can't be read: only Close is offered.
    in property <bool> refusal-can-copy: true;
    in property <string> refusal-body: "";
    in property <string> conflict-replace-label: "Replace";
    in property <bool> conflict-existing-folder: false;
    in property <bool> conflict-incoming-folder: false;
    in property <string> refusal-dismiss: "Cancel";
    // Lines with a note under the path; each adds a row of height.
    in property <int> refusal-notes: 0;
    // How many items were refused; above one the list groups by item.
    in property <int> refusal-lines-items: 1;
    // The live conflict dialog. Defaults match the design render.
    in property <string> conflict-title: "SANDISK already has \"dune-sunset-0412.jpg\"";
    in property <string> conflict-name: "dune-sunset-0412.jpg";
    in property <string> conflict-kind: "JPEG image";
    in property <string> conflict-existing-size: "6.2 MB";
    in property <string> conflict-existing-date: "2026-10-12 21:40";
    in property <string> conflict-existing-badge2: "";
    in property <string> conflict-existing-badge: "Larger";
    in property <string> conflict-incoming-size: "4.1 MB";
    in property <string> conflict-incoming-date: "2026-10-30 18:58";
    in property <string> conflict-incoming-badge2: "";
    in property <string> conflict-incoming-badge: "Newer";
    in property <string> conflict-hint: "Keep both saves it as dune-sunset-0412 (2).jpg";
    in property <string> conflict-note: "";
    in property <string> conflict-apply-label: "Apply to all 14 conflicts";
    in property <bool> conflict-apply: false;
    // Interactive window. Dialog buttons are numbered left to right and the
    // focused one carries the ring; Tab, arrows, Enter, and Esc drive them.
    in property <int> dialog-focus: 0;
    // The danger button unlocks 600ms after the delete dialog opens.
    in property <bool> danger-armed: false;
    in property <string> confirm-noun: "3 items";
    // Lines in confirm-names, at most six: five names and "and N more".
    in property <int> confirm-names-count: 3;
    in property <string> confirm-names: "dune-sunset-0412.jpg\ndune-sunset-0413.jpg\nspeeder-run.mp4";
    in property <bool> job-on: false;
    in property <string> job-glyph: "󰆏";
    in property <string> job-label;
    in property <string> job-detail;
    in property <float> job-amount;
    in property <bool> toast-on: false;
    in property <string> toast-action: "";
    in property <bool> toast-open: false;
    // "Copy 2 items to raw-exports" while a drag is over a folder.
    in property <string> drag-label: "";
    in property <string> drag-glyph: "󰆏";
    callback key(string, bool, bool, bool) -> bool;
    // Row index, 0 down / 1 move / 2 up, rows from the pressed row, moved
    // far enough to be a drag, Ctrl, Shift.
    callback row-pointer(int, int, int, bool, bool, bool);
    callback row-open(int);
    callback dialog-button(int);
    callback job-cancel();
    callback toast-link();
    callback toast-expand();
    forward-focus: keys;

    title: "Robin";
    default-font-family: "JetBrainsMono Nerd Font";
    default-font-size: 12px;
    background: bg;

    property <length> side-row: compact ? 26px : 30px;
    property <length> toolbar-h: compact ? 40px : 46px;
    property <length> icon-box: compact ? 28px : 34px;
    property <length> status-h: compact ? 22px : 26px;
    property <length> side-w: collapsed ? 52px : 232px;
    property <color> hairline: text.with-alpha(0.12);
    property <color> hover: text.with-alpha(0.06);
    property <color> selected: accent.with-alpha(0.18);
    property <color> selected-active: accent.with-alpha(0.28);
    property <color> divider: line;

    keys := FocusScope {
        key-pressed(e) => {
            if root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt) {
                return accept;
            }
            return reject;
        }
    }

    if harness: VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;
        Text { text: "󰋜"; font-size: 14px; color: accent; }
        Text { text: label; font-size: 18px; font-weight: 700; color: text; }
        Text { text: "in development"; font-size: 11px; color: muted; }
        Rectangle {
            background: surface;
            height: 30px;
            border-radius: 6px;
            border-width: 1px;
            border-color: hairline;
            HorizontalLayout {
                padding-left: 8px;
                Text { text: label; font-size: 12px; color: text; vertical-alignment: center; }
            }
        }
    }

    if !harness: HorizontalLayout {
        Rectangle {
            width: side-w;
            vertical-stretch: 1;
            background: surface;
            VerticalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 0px;
                if !collapsed: HorizontalLayout {
                    Rectangle { width: 12px; }
                    Text {
                        text: "PINNED";
                        height: 24px;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1px;
                        color: muted;
                        vertical-alignment: center;
                    }
                }
                for place in pinned-places: SideRow {
                    glyph: place.glyph;
                    name: place.name;
                    count: place.count;
                    picked: place.selected;
                    rail: root.collapsed;
                    side-row: root.side-row;
                    ink: root.text;
                    muted: root.muted;
                    accent: root.accent;
                    selected-bg: root.selected;
                }
                Rectangle { height: 8px; }
                if !collapsed: HorizontalLayout {
                    Rectangle { width: 12px; }
                    Text {
                        text: "DEVICES";
                        height: 24px;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1px;
                        color: muted;
                        vertical-alignment: center;
                    }
                }
                for place in device-places: VerticalLayout {
                    spacing: 1px;
                    SideRow {
                        glyph: place.glyph;
                        name: place.name;
                        count: place.count;
                        picked: false;
                        rail: root.collapsed;
                        side-row: root.side-row;
                        ink: root.text;
                        muted: root.muted;
                        accent: root.accent;
                        selected-bg: root.selected;
                    }
                    if !root.collapsed && place.usage >= 0: Rectangle {
                        height: 4px;
                        Rectangle {
                            x: 38px;
                            y: 0px;
                            width: parent.width - 38px - 8px;
                            height: 3px;
                            border-radius: 2px;
                            background: root.text.with-alpha(0.12);
                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: parent.width * place.usage;
                                height: parent.height;
                                border-radius: 2px;
                                background: place.level == 2 ? root.danger : place.level == 1 ? root.warning : root.accent;
                            }
                        }
                    }
                }
                Rectangle { height: 8px; }
                if !collapsed: HorizontalLayout {
                    Rectangle { width: 12px; }
                    Text {
                        text: "TRASH";
                        height: 24px;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1px;
                        color: muted;
                        vertical-alignment: center;
                    }
                }
                for place in trash-places: SideRow {
                    glyph: place.glyph;
                    name: place.name;
                    count: place.count;
                    picked: false;
                    rail: root.collapsed;
                    side-row: root.side-row;
                    ink: root.text;
                    muted: root.muted;
                    accent: root.accent;
                    selected-bg: root.selected;
                }
                Rectangle { vertical-stretch: 1; }
                SideRow {
                    glyph: "󰄨";
                    name: "Statistics";
                    count: "";
                    picked: root.stats-mode != "";
                    rail: root.collapsed;
                    side-row: root.side-row;
                    ink: root.text;
                    muted: root.muted;
                    accent: root.accent;
                    selected-bg: root.selected;
                }
            }
        }
        Rectangle { width: 1px; background: divider; }
        VerticalLayout {
            Rectangle {
                height: toolbar-h;
                background: bg;
                property <length> iy: (self.height - icon-box) / 2;
                property <length> nav-w: icon-box * 3 + 4px;
                property <length> right-w: icon-box * 4 + 18px;
                property <length> crumb-x: 8px + nav-w + 12px;
                property <length> right-x: self.width - 8px - right-w;
                Rectangle {
                    x: 8px;
                    y: iy;
                    width: icon-box;
                    height: icon-box;
                    border-radius: 3px;
                    Text { text: "󰁍"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    x: 8px + icon-box + 2px;
                    y: iy;
                    width: icon-box;
                    height: icon-box;
                    border-radius: 3px;
                    Text { text: "󰁔"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    x: 8px + (icon-box + 2px) * 2;
                    y: iy;
                    width: icon-box;
                    height: icon-box;
                    border-radius: 3px;
                    Text { text: "󰁝"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    x: crumb-x;
                    y: (parent.height - 30px) / 2;
                    width: right-x - 12px - crumb-x;
                    height: 30px;
                    border-radius: 6px;
                    background: surface;
                    border-width: overlay == "path-invalid" ? 2px : 1px;
                    border-color: overlay == "path-invalid" ? danger : overlay == "path-edit" ? accent : hairline;
                    if overlay != "search" && overlay != "path-edit" && overlay != "path-invalid" && overlay != "path-complete": Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: crumbs;
                        font-size: 12px;
                        color: muted;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    if overlay == "search": Text {
                        x: 8px;
                        width: parent.width - 48px;
                        height: parent.height;
                        text: search-query;
                        font-size: 12px;
                        color: text;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }
                    if overlay == "search": Text {
                        x: parent.width - 40px;
                        width: 32px;
                        height: parent.height;
                        text: search-count;
                        font-size: 11px;
                        color: muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                    if overlay == "path-edit" || overlay == "path-invalid" || overlay == "path-complete": Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: path-text;
                        font-size: 12px;
                        color: text;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }
                Rectangle {
                    x: right-x;
                    y: iy;
                    width: icon-box;
                    height: icon-box;
                    border-radius: 3px;
                    Text { text: "󰍉"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    x: right-x + icon-box + 6px;
                    y: (parent.height - 20px) / 2;
                    width: 1px;
                    height: 20px;
                    background: text.with-alpha(0.14);
                }
                Rectangle {
                    x: right-x + icon-box + 14px;
                    y: iy;
                    width: icon-box;
                    height: icon-box;
                    border-radius: 3px;
                    background: !grid ? selected : transparent;
                    Text { text: "󰈚"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    x: right-x + icon-box * 2 + 16px;
                    y: iy;
                    width: icon-box;
                    height: icon-box;
                    border-radius: 3px;
                    background: grid ? selected : transparent;
                    Text { text: "󰕰"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    x: right-x + icon-box * 3 + 18px;
                    y: iy;
                    width: icon-box;
                    height: icon-box;
                    border-radius: 3px;
                    Text { text: "󰇘"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            Rectangle { height: 1px; background: divider; }

            Rectangle {
                vertical-stretch: 1;
                background: bg;
                if state == "files" && !grid: VerticalLayout {
                    Rectangle {
                        height: 26px;
                        HeaderCell {
                            label: "NAME";
                            column: 0;
                            sorted: root.sort-column == 0;
                            desc: root.sort-desc;
                            x: Columns.name-x;
                            width: Columns.name-w(parent.width);
                            align-right: false;
                            height: parent.height;
                            accent: accent;
                            muted: muted;
                            clicked => { root.sort-by(0); }
                        }
                        HeaderCell {
                            label: "SIZE";
                            column: 1;
                            sorted: root.sort-column == 1;
                            desc: root.sort-desc;
                            x: Columns.size-x(parent.width);
                            width: Columns.size-w;
                            align-right: true;
                            height: parent.height;
                            accent: accent;
                            muted: muted;
                            clicked => { root.sort-by(1); }
                        }
                        HeaderCell {
                            label: "TYPE";
                            column: 2;
                            sorted: root.sort-column == 2;
                            desc: root.sort-desc;
                            x: Columns.type-x(parent.width);
                            width: Columns.type-w;
                            align-right: false;
                            height: parent.height;
                            accent: accent;
                            muted: muted;
                            clicked => { root.sort-by(2); }
                        }
                        HeaderCell {
                            label: "MODIFIED";
                            column: 3;
                            sorted: root.sort-column == 3;
                            desc: root.sort-desc;
                            x: Columns.mod-x(parent.width);
                            width: Columns.mod-w;
                            align-right: false;
                            height: parent.height;
                            accent: accent;
                            muted: muted;
                            clicked => { root.sort-by(3); }
                        }
                    }
                    Rectangle { height: 1px; background: divider; }
                    ListView {
                        vertical-stretch: 1;
                        viewport-y <=> root.list-scroll;
                        for row[i] in files: Rectangle {
                            width: parent.width;
                            height: row-h;
                            background: row.drop ? selected : row.selected && !row.drop-refused ? selected-active : row.hovered ? hover : transparent;
                            border-radius: 6px;
                            border-width: row.drop ? 2px : row.drop-refused ? 1px : 0px;
                            border-color: row.drop-refused ? muted : accent;
                            opacity: row.cut ? 0.5 : 1;
                            TouchArea {
                                pointer-event(e) => {
                                    if e.button == PointerEventButton.left || e.kind == PointerEventKind.move {
                                        root.row-pointer(
                                            i,
                                            e.kind == PointerEventKind.down ? 0 : e.kind == PointerEventKind.up ? 2 : 1,
                                            floor(self.mouse-y / row-h),
                                            self.pressed && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px),
                                            e.modifiers.control,
                                            e.modifiers.shift);
                                    }
                                }
                                double-clicked => { root.row-open(i); }
                            }
                            Text {
                                text: row.glyph;
                                x: Columns.pad;
                                y: 0px;
                                width: Columns.icon-w;
                                height: parent.height;
                                font-size: 14px;
                                color: row.role == 2 ? danger : row.role == 3 ? warning : row.role == 1 ? accent : row.role == 4 ? muted : text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Text {
                                text: row.name;
                                x: Columns.name-x;
                                y: 0px;
                                width: Columns.name-w(parent.width);
                                height: parent.height;
                                font-size: 12px;
                                font-weight: row.selected ? 700 : 400;
                                color: text;
                                opacity: row.hidden ? 0.6 : 1;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: row.size;
                                x: Columns.size-x(parent.width);
                                y: 0px;
                                width: Columns.size-w;
                                height: parent.height;
                                font-size: 12px;
                                color: muted;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: row.kind;
                                x: Columns.type-x(parent.width);
                                y: 0px;
                                width: Columns.type-w;
                                height: parent.height;
                                font-size: 12px;
                                color: muted;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: row.modified;
                                x: Columns.mod-x(parent.width);
                                y: 0px;
                                width: Columns.mod-w;
                                height: parent.height;
                                font-size: 12px;
                                color: muted;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
                if state == "files" && grid: ListView {
                    vertical-stretch: 1;
                    viewport-y <=> root.grid-scroll;
                    for line in grid-rows: HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 8px;
                        padding-bottom: 0px;
                        spacing: 8px;
                        height: tile + 60px;
                        if line.n > 0: Tile {
                            glyph: line.g0; name: line.n0; role: line.r0; badge: line.b0; picked: line.s0; hot: line.h0;
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 1: Tile {
                            glyph: line.g1; name: line.n1; role: line.r1; badge: line.b1; picked: line.s1; hot: line.h1;
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 2: Tile {
                            glyph: line.g2; name: line.n2; role: line.r2; badge: line.b2; picked: line.s2; hot: line.h2;
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 3: Tile {
                            glyph: line.g3; name: line.n3; role: line.r3; badge: line.b3; picked: line.s3; hot: line.h3;
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 4: Tile {
                            glyph: line.g4; name: line.n4; role: line.r4; badge: line.b4; picked: line.s4; hot: line.h4;
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 5: Tile {
                            glyph: line.g5; name: line.n5; role: line.r5; badge: line.b5; picked: line.s5; hot: line.h5;
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                    }
                }
                if state == "empty" || state == "denied" || state == "unmounted" || state == "ejected" || state == "nosearch" || state == "loading": VerticalLayout {
                    alignment: center;
                    width: parent.width;
                    Text {
                        text: state == "empty" ? "󰉖" : state == "denied" ? "󰌾" : state == "nosearch" ? "󰍉" : state == "loading" ? "" : "󰕓";
                        font-size: 64px;
                        color: state == "denied" || state == "ejected" ? warning.with-alpha(0.6) : muted.with-alpha(0.6);
                        horizontal-alignment: center;
                        width: parent.width;
                    }
                    Rectangle { height: 12px; }
                    Text {
                        text: state == "empty" ? "This folder is empty" : state == "denied" ? "No permission to open ~/secret" : state == "unmounted" ? "SANDISK is not mounted" : state == "ejected" ? "SANDISK was removed" : state == "nosearch" ? "Nothing matches \"kotlin\"" : "Reading…";
                        font-size: 18px;
                        font-weight: 700;
                        color: text;
                        horizontal-alignment: center;
                        width: parent.width;
                    }
                    Rectangle { height: 6px; }
                    Text {
                        text: state == "empty" ? "Drop files here or press Ctrl+N" : state == "denied" ? "Owned by root (drwx------)" : state == "nosearch" ? "Searched 4 812 items in ~/Projects" : state == "loading" ? "18 240 items" : "";
                        font-size: 11px;
                        color: muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        width: parent.width;
                    }
                }
            }

            if job-on: Rectangle {
                height: 44px;
                background: surface;
                JobRow {
                    row-h: 44px;
                    glyph: job-glyph;
                    label: job-label;
                    detail: job-detail;
                    amount: job-amount;
                    failed: false;
                    cancel-link: true;
                    cancel => { root.job-cancel(); }
                    ink: root.text;
                    muted-ink: root.muted;
                    accent-ink: root.accent;
                    danger-ink: root.danger;
                }
            }
            if overlay == "progress-1" || overlay == "progress-3" || overlay == "progress-error": Rectangle {
                height: overlay == "progress-3" ? 116px : 44px;
                background: surface;
                VerticalLayout {
                    alignment: start;
                    JobRow {
                        row-h: 44px;
                        glyph: "󰆏";
                        label: "Copying 1 204 files to SANDISK";
                        detail: "2.1 / 6.4 GB · 84 MB/s · 52s left";
                        amount: overlay == "progress-error" ? 0.4 : 0.33;
                        failed: overlay == "progress-error";
                        ink: root.text;
                        muted-ink: root.muted;
                        accent-ink: root.accent;
                        danger-ink: root.danger;
                    }
                    if overlay == "progress-3": JobRow {
                        row-h: 36px;
                        glyph: "󰪹";
                        label: "Moving 12 files to archive";
                        detail: "840 MB / 1.2 GB · 40 MB/s";
                        amount: 0.7;
                        failed: false;
                        ink: root.text;
                        muted-ink: root.muted;
                        accent-ink: root.accent;
                        danger-ink: root.danger;
                    }
                    if overlay == "progress-3": JobRow {
                        row-h: 36px;
                        glyph: "󰩺";
                        label: "Moving 3 items to trash";
                        detail: "12 MB";
                        amount: 0.15;
                        failed: false;
                        ink: root.text;
                        muted-ink: root.muted;
                        accent-ink: root.accent;
                        danger-ink: root.danger;
                    }
                }
            }

            Rectangle { height: 1px; background: divider; }
            Rectangle {
                height: status-h;
                background: bg;
                property <length> free-w: 188px;
                Text {
                    text: status-left;
                    x: 12px;
                    y: 0px;
                    width: parent.width - 24px - free-w;
                    height: parent.height;
                    font-size: 11px;
                    color: muted;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: status-right;
                    x: parent.width - 12px - free-w;
                    y: 0px;
                    width: free-w;
                    height: parent.height;
                    font-size: 11px;
                    color: muted;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    if !harness && (toast-on || overlay == "skipped" || overlay == "skipped-details" || overlay == "toast-details"): Rectangle {
        property <bool> open: overlay == "skipped-details" || overlay == "toast-details" || toast-open;
        property <color> tone: toast-tone == "warning" ? warning : toast-tone == "danger" ? danger : muted;
        property <length> line-h: 20px;
        // Fit the line, 520px to 800px, and never wider than the window.
        width: min(max(520px, min(800px, toast-line.preferred-width + 42px + 120px)), parent.width - side-w - 32px);
        // A pinned line, then up to seven items and "+N more"; expanded,
        // the items scroll past 240px so the toast never covers the list.
        property <length> pin-h: toast-pin != "" ? line-h : 0px;
        property <length> rows-h: toast-details.length * line-h + (toast-more > 0 ? line-h : 0px);
        property <length> list-h: toast-expanded ? min(240px, rows-h) : rows-h;
        height: open ? 52px + 12px + pin-h + list-h + 12px : 52px;
        x: side-w + (parent.width - side-w - self.width) / 2;
        y: parent.height - status-h - 16px - self.height;
        background: surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: toast-tone == "" || toast-tone == "info" ? hairline : tone;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000.with-alpha(0.35);
        if toast-tone == "warning" || toast-tone == "danger": Rectangle {
            x: 0px;
            y: 0px;
            width: 4px;
            height: parent.height;
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
            background: tone;
        }
        Text {
            text: toast-glyph;
            x: 16px;
            y: 0px;
            width: 18px;
            height: 52px;
            font-size: 14px;
            color: tone;
            vertical-alignment: center;
        }
        toast-line := Text {
            text: toast-text;
            x: 42px;
            y: 0px;
            width: parent.width - 42px - 120px;
            height: 52px;
            font-size: 13px;
            color: text;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            text: toast-details.length == 0 ? toast-action : open ? "Hide details" : "Details";
            x: parent.width - 16px - self.width;
            y: 0px;
            width: 96px;
            height: 52px;
            font-size: 12px;
            color: accent;
            horizontal-alignment: right;
            vertical-alignment: center;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toast-link(); }
            }
        }
        if open: Rectangle {
            x: 16px;
            y: 52px;
            width: parent.width - 32px;
            height: 1px;
            background: hairline;
        }
        if open && toast-pin != "": Text {
            x: 42px;
            y: 52px + 12px;
            width: parent.width - 58px;
            height: line-h;
            text: toast-pin;
            font-size: 11px;
            color: text;
            overflow: elide;
            vertical-alignment: center;
        }
        if open: Flickable {
            x: 42px;
            y: 52px + 12px + pin-h;
            width: parent.width - 58px;
            height: list-h;
            viewport-height: rows-h;
            VerticalLayout {
                spacing: 0px;
                for detail in toast-details: Text {
                    text: detail;
                    height: line-h;
                    font-size: 11px;
                    color: muted;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if toast-more > 0: Text {
                    text: "+" + toast-more + " more";
                    height: line-h;
                    font-size: 11px;
                    color: muted;
                    vertical-alignment: center;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toast-expand(); }
                    }
                }
            }
        }
    }

    if !harness && (overlay == "trash" || overlay == "trash-no" || overlay == "delete" || overlay == "move-refused" || overlay == "menu-file" || overlay == "shortcuts"): Rectangle {
        background: #000000.with-alpha(0.6);
        if overlay == "delete" || overlay == "trash" || overlay == "trash-no": Rectangle {
            width: 440px;
            // Title, note, up to six name lines ("and N more"), buttons.
            height: 150px + max(1, confirm-names-count) * 15px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                if overlay == "delete": HorizontalLayout {
                    spacing: 8px;
                    Text { text: "󰀦"; width: 18px; height: 20px; font-size: 15px; color: danger; horizontal-alignment: center; vertical-alignment: center; }
                    Text { text: "Permanently delete \{confirm-noun}?"; font-size: 13px; font-weight: 700; color: text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                }
                if overlay != "delete": Text {
                    text: overlay == "trash-no" ? "This drive has no trash" : "Move \{confirm-noun} to trash?";
                    font-size: 13px;
                    font-weight: 700;
                    color: text;
                }
                Text {
                    text: overlay == "delete" ? "This can't be undone." : overlay == "trash-no" ? "Robin will not copy these files home." : "You can restore them from Trash.";
                    font-size: 12px;
                    color: muted;
                }
                Text { text: confirm-names; font-size: 11px; color: muted; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Rectangle {
                        width: 88px;
                        height: 32px;
                        border-radius: 6px;
                        border-width: dialog-focus == 0 ? 2px : 1px;
                        border-color: dialog-focus == 0 ? accent : line;
                        Text { text: "Cancel"; font-size: 12px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.dialog-button(0); } }
                    }
                    Rectangle {
                        // Grows to fit its label with 16px either side.
                        width: max(88px, confirm-label.preferred-width + 32px);
                        height: 32px;
                        border-radius: 6px;
                        background: overlay == "delete" || overlay == "trash-no" ? danger : accent;
                        opacity: overlay == "delete" && !danger-armed ? 0.42 : 1;
                        border-width: dialog-focus == 1 ? 2px : 0px;
                        border-color: text;
                        TouchArea { clicked => { root.dialog-button(1); } }
                        confirm-label := Text {
