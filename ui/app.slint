import "../assets/fonts/JetBrainsMonoNerdFont-Regular.ttf";
import "../assets/fonts/JetBrainsMonoNerdFont-Bold.ttf";
import "../assets/fonts/JetBrainsMonoNerdFont-Medium.ttf";
import { ListView } from "std-widgets.slint";

// Column x positions are computed once from the list width. Header and rows
// both call these. Name is whatever is left; the other cells do not move.
export global Columns {
    out property <length> pad: 12px;
    out property <length> icon-w: 20px;
    out property <length> name-x: 40px;
    out property <length> gutter: 16px;
    // The list's width. Narrow lists shrink the fixed columns so the
    // Name column gets the spare width first.
    in-out property <length> row-w: 800px;
    out property <bool> narrow: row-w < 640px;
    out property <bool> tight: row-w < 480px;
    // Narrow lists drop the Type column before any name is cut.
    // One cut where the columns stop shrinking, so Type never comes
    // back as the list narrows. Mirrored by `columns` in app.rs.
    out property <bool> no-type: row-w < 668px;
    out property <length> size-w: tight ? 64px : narrow ? 72px : 88px;
    out property <length> type-w: no-type ? 0px : 120px;
    // Never below what "MODIFIED" and its sort arrow need.
    out property <length> mod-w: tight ? 92px : narrow ? 104px : 140px;
    public pure function mod-x(row-w: length) -> length {
        row-w - pad - mod-w
    }
    public pure function type-x(row-w: length) -> length {
        mod-x(row-w) - gutter - type-w
    }
    public pure function size-x(row-w: length) -> length {
        (no-type ? mod-x(row-w) : type-x(row-w)) - gutter - size-w
    }
    public pure function name-w(row-w: length) -> length {
        size-x(row-w) - gutter - name-x
    }
}

export struct RefusalLine {
    path: string,
    note: string,
    // An item's own line when several moves were refused.
    head: bool,
}

export struct Place {
    glyph: string,
    name: string,
    count: string,
    selected: bool,
    usage: float,
    level: int,
    section: int,
}

// A searched name split around the part that matched.
export struct MarkRun {
    text: string,
    hit: bool,
}

export struct Mark {
    runs: [MarkRun],
}

export struct Row {
    glyph: string,
    name: string,
    size: string,
    kind: string,
    modified: string,
    selected: bool,
    hovered: bool,
    hidden: bool,
    role: int,
    badge: string,
    // Cut and waiting for a paste: drawn at 50%.
    cut: bool,
    // The folder a drag is over.
    drop: bool,
    // The folder a drag is over but can't drop into (it is being dragged).
    drop-refused: bool,
}

export struct GridLine {
    n: int,
    // The view index of the line's first tile.
    first: int,
    g0: string, n0: string, r0: int, b0: string, s0: bool, h0: bool, f0: bool,
    g1: string, n1: string, r1: int, b1: string, s1: bool, h1: bool, f1: bool,
    g2: string, n2: string, r2: int, b2: string, s2: bool, h2: bool, f2: bool,
    g3: string, n3: string, r3: int, b3: string, s3: bool, h3: bool, f3: bool,
    g4: string, n4: string, r4: int, b4: string, s4: bool, h4: bool, f4: bool,
    g5: string, n5: string, r5: int, b5: string, s5: bool, h5: bool, f5: bool,
}

export struct ViewTile {
    shot: image,
    current: bool,
    // A video: shows its cached frame, or the video icon without one.
    video: bool,
    // An audio file: the music icon (or its cover, if a frame is cached).
    audio: bool,
}

export struct Fact {
    key: string,
    value: string,
}

export struct StatDisk {
    name: string,
    mount: string,
    amount: float,
    // 0 accent, 1 warning (85%+), 2 danger (95%+).
    level: int,
    pct: string,
    free: string,
}

export struct StatType {
    name: string,
    count: string,
    size: string,
    start: float,
    share: float,
    alpha: float,
}

// One context-menu line (DESIGN §7): a separator, or an item with a
// glyph, label, shortcut and optional submenu marker.
export struct MenuItem {
    glyph: string,
    label: string,
    shortcut: string,
    danger: bool,
    sub: bool,
    sep: bool,
}

// One shortcut-overlay line: its key caps, then what it does.
export struct KeyRow {
    keys: [string],
    label: string,
}

// A shortcut-overlay column under its `t-label` header.
export struct KeySection {
    title: string,
    rows: [KeyRow],
}

export struct MapCell {
    x: length,
    y: length,
    w: length,
    h: length,
    name: string,
    detail: string,
    shade: float,
    // A lone tile: surface tint ringed in accent, not a solid block.
    outline: bool,
}

// A dialog or empty-state button (DESIGN §4): 32 tall, min 88 wide,
// primary in accent, secondary outlined in `line`.
component StateButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <color> ink;
    in property <color> line-ink;
    in property <color> accent;
    in property <color> on-accent;
    in property <color> hover-bg;
    callback clicked;
    width: max(88px, button-label.preferred-width + 32px);
    height: 32px;
    border-radius: 6px;
    border-width: primary ? 0px : 1px;
    border-color: line-ink;
    background: primary ? (button-touch.has-hover ? accent.with-alpha(0.85) : accent) : (button-touch.has-hover ? hover-bg : transparent);
    button-label := Text { text: label; font-size: 12px; color: primary ? on-accent : ink; horizontal-alignment: center; vertical-alignment: center; }
    button-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A 2px dashed stroke (dash 6, gap 4) around its box: the valid drop
// target (DESIGN §0 `drop_target`). Slint has no dashed borders.
component DashedFrame inherits Rectangle {
    in property <color> ink;
    property <int> across: ceil(self.width / 10px);
    property <int> down: ceil(self.height / 10px);
    for i in across: Rectangle { x: i * 10px; y: 0px; width: min(6px, root.width - i * 10px); height: 2px; background: ink; }
    for i in across: Rectangle { x: i * 10px; y: root.height - 2px; width: min(6px, root.width - i * 10px); height: 2px; background: ink; }
    for i in down: Rectangle { x: 0px; y: i * 10px; width: 2px; height: min(6px, root.height - i * 10px); background: ink; }
    for i in down: Rectangle { x: root.width - 2px; y: i * 10px; width: 2px; height: min(6px, root.height - i * 10px); background: ink; }
}

// A key cap in the shortcut overlay: `t-small`, 1px `line`, radius r-xs,
// padding 4/1, min width 20.
component KeyCap inherits Rectangle {
    in property <string> key;
    in property <color> ink;
    in property <color> line-ink;
    width: max(20px, cap-label.preferred-width + 8px);
    height: 18px;
    border-radius: 2px;
    border-width: 1px;
    border-color: line-ink;
    cap-label := Text { text: key; font-size: 11px; color: ink; horizontal-alignment: center; vertical-alignment: center; }
}

component SideRow inherits Rectangle {
    in property <string> glyph;
    in property <string> name;
    in property <string> count;
    in property <bool> picked;
    in property <bool> rail;
    in property <length> side-row;
    in property <color> ink;
    in property <color> muted;
    in property <color> accent;
    in property <color> selected-bg;
    // A drive past 85% (amber) or 95% (red) full: on the rail, where the
    // usage bar is gone, a dot on the icon says so.
    in property <bool> dot;
    in property <color> dot-color;
    callback clicked;
    height: side-row;
    border-radius: 6px;
    TouchArea { clicked => { root.clicked(); } }
    background: picked ? selected-bg : transparent;
    border-width: picked ? 1px : 0px;
    border-color: accent;
    Text {
        text: glyph;
        x: 12px;
        y: 0px;
        width: 18px;
        height: parent.height;
        font-size: 14px;
        color: muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if rail && dot: Rectangle {
        x: 27px;
        y: parent.height / 2 - 9px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: dot-color;
    }
    if !rail: Text {
        text: name;
        x: 38px;
        y: 0px;
        width: parent.width - 38px - 72px;
        height: parent.height;
        font-size: 12px;
        color: ink;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: elide;
    }
    if !rail: Text {
        text: count;
        x: parent.width - 8px - 64px;
        y: 0px;
        width: 64px;
        height: parent.height;
        font-size: 11px;
        color: muted;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// A thumbnail inset like the icons, scaled to fit whole (never
// cropped), with its own corners rounded.
component Thumb inherits Rectangle {
    in property <image> source;
    in property <length> box;
    property <float> sw: max(1, source.width);
    property <float> sh: max(1, source.height);
    property <float> k: min(1 / sw, 1 / sh);
    width: box * sw * k;
    height: box * sh * k;
    border-radius: 4px;
    clip: true;
    Image { source: root.source; width: parent.width; height: parent.height; image-fit: fill; }
}

component Tile inherits Rectangle {
    in property <string> glyph;
    in property <string> name;
    in property <int> role;
    in property <string> badge;
    in property <bool> picked;
    in property <bool> hot;
    in property <length> tile;
    in property <color> ink;
    in property <color> accent;
    in property <color> danger;
    in property <color> warning;
    in property <color> muted;
    in property <color> surface;
    in property <color> selected-bg;
    in property <color> hover-bg;
    in property <bool> faded;
    // kind (0 down, 1 move, 2 up), tiles across and lines down from the
    // pressed tile, past the drag threshold, ctrl, shift.
    callback pointer(int, int, int, bool, bool, bool);
    callback open();
    property <bool> still: name == "dune-sunset-0412.jpg" || name == "dune-sunset-0413.jpg" || name == "speeder-run.mp4" || name == "cantina-band.heic" || name == "droid-manual.pdf" || name == "lars homestead family portrait final.jpg";
    property <string> label: name == "dune-sunset-0412.jpg" ? "dune-sunset-\n0412.jpg" : name == "dune-sunset-0413.jpg" ? "dune-sunset-\n0413.jpg" : name == "speeder-run.mp4" ? "speeder-\nrun.mp4" : name == "cantina-band.heic" ? "cantina-\nband.heic" : name == "droid-manual.pdf" ? "droid-\nmanual.pdf" : name == "holo-backup.tar.zst" ? "holo-backup.\ntar.zst" : name == "binary-sunset.flac" ? "binary-\nsunset.flac" : name == "lars homestead family portrait final.jpg" ? "lars homestead\nfamily portrait final.jpg" : name;
    width: tile;
    height: tile + 44px;
    border-radius: 6px;
    opacity: faded ? 0.6 : 1;
    background: picked ? selected-bg : hot || tile-touch.has-hover ? hover-bg : transparent;
    tile-touch := TouchArea {
        pointer-event(e) => {
            if e.button == PointerEventButton.left || e.kind == PointerEventKind.move {
                root.pointer(
                    e.kind == PointerEventKind.down ? 0 : e.kind == PointerEventKind.up ? 2 : 1,
                    floor(self.mouse-x / (tile + 8px)),
                    floor(self.mouse-y / (tile + 60px)),
                    self.pressed && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px),
                    e.modifiers.control,
                    e.modifiers.shift);
            }
        }
        double-clicked => { root.open(); }
    }
    VerticalLayout {
        padding: 6px;
        alignment: center;
        Rectangle {
            width: tile - 12px;
            height: tile - 12px;
            border-radius: 4px;
            background: surface;
            if name == "dune-sunset-0412.jpg": Thumb { box: parent.width - 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("../assets/thumbs/dune-sunset-0412.jpg"); }
            if name == "dune-sunset-0413.jpg": Thumb { box: parent.width - 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("../assets/thumbs/dune-sunset-0413.jpg"); }
            if name == "speeder-run.mp4": Thumb { box: parent.width - 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("../assets/thumbs/speeder-frame.png"); }
            if name == "cantina-band.heic": Thumb { box: parent.width - 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("../assets/thumbs/cantina-band.png"); }
            if name == "droid-manual.pdf": Thumb { box: parent.width - 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("../assets/thumbs/droid-manual.png"); }
            if name == "lars homestead family portrait final.jpg": Thumb { box: parent.width - 16px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("../assets/thumbs/lars-homestead.jpg"); }
            if !still: Text {
                text: glyph;
                width: parent.width;
                height: parent.height;
                wrap: no-wrap;
                overflow: clip;
                font-size: tile * 0.32;
                color: role == 2 ? danger : role == 3 ? warning : role == 1 ? accent : role == 4 ? muted : ink;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if badge != "": Rectangle {
                x: 4px;
                y: 4px;
                width: 44px;
                height: 14px;
                border-radius: 2px;
                background: #000000.with-alpha(0.62);
                Text { text: badge; font-size: 9px; font-weight: 600; color: #e7fbff; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Text {
            text: label;
            font-size: 12px;
            color: ink;
            horizontal-alignment: center;
            overflow: elide;
            wrap: word-wrap;
            height: 32px;
        }
    }
}

component JobRow inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> detail;
    in property <float> amount;
    in property <bool> failed;
    in property <color> ink;
    in property <color> muted-ink;
    in property <color> accent-ink;
    in property <color> danger-ink;
    in property <length> row-h: 44px;
    // Live jobs show a Cancel link instead of the pause and close glyphs.
    in property <bool> cancel-link: false;
    callback cancel();
    height: row-h;
    property <length> btn: 28px;
    property <length> action-w: failed ? 112px : btn * 2 + 2px;
    property <length> action-x: self.width - 8px - action-w;
    // Label, bar and figures share what the actions leave. At the 1280
    // reference they get 280 / flex / 228; a narrower strip shrinks the
    // label and figures (both elide), and the bar goes before they do.
    property <length> avail: max(0px, action-x - 8px - 40px);
    property <length> label-w: min(280px, avail * 0.38);
    property <length> stats-w: min(228px, avail * 0.34);
    property <length> stats-x: action-x - 8px - stats-w;
    property <length> bar-x: 40px + label-w + 12px;
    property <length> bar-w: stats-x - 12px - bar-x;
    Text {
        text: glyph;
        x: 12px;
        y: 0px;
        width: 20px;
        height: parent.height;
        font-size: 16px;
        color: failed ? danger-ink : accent-ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        text: label;
        x: 40px;
        y: 0px;
        width: label-w;
        height: parent.height;
        font-size: 12px;
        color: ink;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: elide;
    }
    if bar-w >= 48px: Rectangle {
        x: bar-x;
        y: (parent.height - 4px) / 2;
        width: bar-w;
        height: 4px;
        border-radius: 2px;
        background: ink.with-alpha(0.12);
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width * amount;
            height: parent.height;
            border-radius: 2px;
            background: failed ? danger-ink : accent-ink;
        }
    }
    Text {
        text: detail;
        x: stats-x;
        y: 0px;
        width: stats-w;
        height: parent.height;
        font-size: 11px;
        color: muted-ink;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
    if cancel-link: Text {
        text: "Cancel";
        x: action-x;
        y: 0px;
        width: action-w;
        height: parent.height;
        font-size: 12px;
        color: accent-ink;
        horizontal-alignment: right;
        vertical-alignment: center;
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.cancel(); }
        }
    }
    if !failed && !cancel-link: Rectangle {
        x: action-x;
        y: (parent.height - btn) / 2;
        width: btn;
        height: btn;
        border-radius: 3px;
        Text {
            text: "󰏤";
            font-size: 14px;
            color: ink;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if !failed && !cancel-link: Rectangle {
        x: action-x + btn + 2px;
        y: (parent.height - btn) / 2;
        width: btn;
        height: btn;
        border-radius: 3px;
        Text {
            text: "󰅖";
            font-size: 14px;
            color: ink;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if failed: Text {
        text: "Retry";
        x: action-x;
        y: 0px;
        width: 56px;
        height: parent.height;
        font-size: 11px;
        color: ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if failed: Text {
        text: "Skip";
        x: action-x + 56px;
        y: 0px;
        width: 56px;
        height: parent.height;
        font-size: 11px;
        color: muted-ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component FilmTile inherits Rectangle {
    in property <image> shot;
    in property <bool> current;
    in property <color> ring;
    in property <bool> video: false;
    in property <bool> audio: false;
    in property <color> ink: #888888;
    width: 72px;
    height: 48px;
    border-radius: 3px;
    border-width: current ? 2px : 0px;
    border-color: ring;
    Image {
        source: shot;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
        opacity: current ? 1 : 0.62;
    }
    // No picture yet (loading) or ever (unreadable): the video icon or
    // the file icon; never a blank tile.
    if shot.width == 0: Text {
        text: audio ? "󰎆" : video ? "󰕧" : "󰈟";
        width: parent.width;
        height: parent.height;
        font-size: 20px;
        color: ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // Play badge centred on the frame, about 40% of the tile's height.
    if video && shot.width > 0: Rectangle {
        width: parent.height * 0.4;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: #000000a0;
        Text {
            text: "󰐊";
            font-size: parent.width * 0.6;
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if current: Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 3px;
        border-width: 2px;
        border-color: ring;
    }
}

component MetaRow inherits Rectangle {
    in property <string> key;
    in property <string> value;
    in property <color> ink;
    in property <color> muted-ink;
    height: 20px;
    Text {
        text: key;
        x: 0px;
        y: 0px;
        width: 120px;
        height: parent.height;
        font-size: 12px;
        color: muted-ink;
        horizontal-alignment: left;
        vertical-alignment: center;
    }
    Text {
        text: value;
        x: 120px;
        y: 0px;
        width: parent.width - 120px;
        height: parent.height;
        font-size: 12px;
        color: ink;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }
}

component TypeRow inherits Rectangle {
    in property <string> name;
    in property <string> count;
    in property <string> size;
    in property <color> ink;
    in property <color> muted-ink;
    in property <color> swatch;
    // Fixed right-aligned colwumns; the name keeps at least name-min.
    // Without room for all three the count goes and the size stays.
    property <length> name-min: 72px;
    property <length> colw: 64px;
    property <length> gapw: 8px;
    property <bool> with-count: self.width >= 18px + name-min + gapw + colw + gapw + colw;
    height: 22px;
    Rectangle {
        x: 0px;
        y: 6px;
        width: 10px;
        height: 10px;
        border-radius: 2px;
        background: swatch;
    }
    Text {
        text: name;
        x: 18px;
        y: 0px;
        width: max(name-min, parent.width - 18px - gapw - (with-count ? colw + gapw + colw : colw));
        height: parent.height;
        font-size: 12px;
        color: ink;
        overflow: elide;
        vertical-alignment: center;
    }
    if with-count: Text {
        text: count;
        x: parent.width - colw - gapw - colw;
        y: 0px;
        width: colw;
        height: parent.height;
        font-size: 12px;
        color: muted-ink;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    Text {
        text: size;
        x: parent.width - colw;
        y: 0px;
        width: colw;
        height: parent.height;
        font-size: 12px;
        color: ink;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Track with the fill pinned to the left edge. A width-only child is centred.
component Meter inherits Rectangle {
    in property <float> amount;
    in property <color> fill;
    in property <color> track;
    background: track;
    border-radius: 4px;
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * amount;
        height: parent.height;
        border-radius: 4px;
        background: fill;
    }
}

// A list column header: click to sort, again to reverse. The sorted
// column is accented and carries the direction arrow.
component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <int> column;
    in property <bool> sorted;
    in property <bool> desc;
    in property <bool> align-right;
    in property <color> accent;
    in property <color> muted;
    callback clicked();
    y: 0px;
    Text {
        text: root.sorted ? (root.align-right ? (root.desc ? "󰁅  " : "󰁝  ") + root.label : root.label + (root.desc ? "  󰁅" : "  󰁝")) : root.label;
        width: parent.width;
        height: parent.height;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        color: root.sorted ? root.accent : root.muted;
        horizontal-alignment: root.align-right ? right : left;
        vertical-alignment: center;
        overflow: elide;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    property <length> row-h: compact ? 24px : 30px;
    in property <bool> harness: true;
    in property <color> bg: #061216;
    in property <color> surface: #0e1e26;
    in property <color> text: #e7fbff;
    in property <color> muted: #7ec8d4;
    in property <color> accent: #00e5ff;
    in property <color> on-accent: #042028;
    in property <color> line: #1e6a78;
    in property <color> danger: #ff2a4a;
    in property <color> on-danger: #fff5f6;
    in property <color> warning: #ffb000;
    in property <color> on-warning: #1a1200;
    in property <string> label: "Robin";
    in property <bool> compact: false;
    in property <bool> grid: false;
    callback set-grid(bool);
    callback toggle-hidden();
    // The content area's width; the grid's column count follows it.
    out property <length> content-w: root.width - side-w - 1px;
    callback content-resized();
    changed content-w => { root.content-resized(); }
    // The open folder is the Trash: Name, Original location, Deleted.
    in property <bool> trash-view: false;
    in property <bool> trash-can-restore: false;
    // Set when the selection holds items with no trashinfo.
    in property <string> trash-note;
    callback trash-restore();
    callback trash-empty();
    in property <bool> collapsed: false;
    // The status bar's free space without the drive size, for narrow windows.
    in property <string> status-free-short;
    in property <length> tile: 152px;
    in property <int> grid-columns: 3;
    // Middle-elided list names, by row; empty falls back to the name.
    in property <[string]> labels;
    in property <[Mark]> marks;
    in property <string> state: "files";
    /// The line under "Reading…" while a folder loads.
    in property <string> state-note: "";
    /// The headline of the denied state.
    in property <string> state-title: "";
    /// A navigation read is slow: a thin progress bar under the toolbar.
    in property <bool> nav-busy: false;
    // Rows are still streaming in (or the first read hasn't landed): the
    // 2px bar runs under the toolbar without dimming the list.
    in property <bool> reading: false;
    // A button under an empty or error state: "new-folder", "admin",
    // "back", "mount", "home", "search-hidden", "clear".
    callback state-action(string);
    // The no-results state offers [Search hidden files] only when hidden
    // files were left out.
    in property <bool> search-hidden-offer: false;
    // The Move-to-trash confirm's "Don't ask again" box.
    in property <bool> trash-dont-ask: false;
    // Replace is amber when the file it overwrites is newer.
    in property <bool> conflict-replace-warn: false;
    // Path completion: matching folders, at most 8 shown.
    in property <[string]> completions;
    // The context menu's lines, for "menu-file" and "menu-bg".
    in property <[MenuItem]> menu-items;
    // The shortcut overlay's three columns and its filter text.
    in property <[KeySection]> key-sections;
    in property <string> key-filter: "";
    /// Renders pin the bar's position (0..1); negative animates it.
    in property <float> nav-phase: -1;
    in property <string> overlay: "";
    in property <string> viewer: "";
    // The real viewer (harness), driven by src/viewer.rs.
    in property <bool> view-on: false;
    in property <image> view-image;
    in property <string> view-name;
    in property <string> view-counter;
    in property <string> view-zoom;
    // The image's pixel size, and the zoom: 0 fits (never above 100%).
    in property <float> view-px-w;
    in property <float> view-px-h;
    in property <float> view-scale: 0;
    in property <bool> view-info: false;
    in property <bool> view-strip: true;
    in property <bool> view-video: false;
    // The top bar, filmstrip and toolbar; hidden while zoomed past fit.
    in property <bool> view-chrome: true;
    // How far the picture is moved from centre, in pixels.
    in property <float> view-pan-x: 0;
    in property <float> view-pan-y: 0;
    // Why there is no picture (undecodable, or video without libmpv).
    in property <string> view-note;
    // Decoding the first picture: show this stand-in (a blurred tile, or
    // nothing for a surface box), and after 300 ms a spinner.
    in property <bool> view-loading: false;
    in property <image> view-placeholder;
    in property <bool> view-spinner: false;
    in property <string> view-dir;
    in property <[ViewTile]> view-tiles;
    // The current item's place in view-tiles.
    in property <int> view-tile-at;
    in property <[Fact]> view-facts;
    callback view-close();
    callback view-go(int);
    callback view-key(string);
    callback view-external();
    // Playback (src/mpv.rs): a video or audio file plays in the viewer
    // and the transport replaces the toolbar (DESIGN §5).
    in property <bool> view-playing: false;
    // Playing with no picture (audio without cover art): a music glyph.
    in property <bool> view-audio: false;
    in property <bool> view-paused: false;
    in property <string> view-clock: "00:00 / 00:00";
    in property <float> view-progress: 0;
    in property <float> view-duration: 0;
    in property <float> view-volume: 1;
    in property <bool> view-muted: false;
    in property <string> view-speed: "1.0×";
    in property <bool> view-loop: false;
    in property <bool> view-subs: false;
    in property <bool> view-full: false;
    // "Resume at 02:14?", or empty.
    in property <string> view-resume;
    // ("toggle"|"seek"|"volume"|"mute"|"speed"|"loop"|"subs"|"full"|
    // "resume"|"resume-close", value).
    callback view-transport(string, float);
    callback view-pan(float, float);
    callback view-wake();
    in property <string> stats-mode: "";
    in property <[MapCell]> map-cells;
    in property <[StatDisk]> stat-disks;
    in property <[StatType]> stat-types;
    in property <string> stat-scanned: "";
    in property <bool> stat-scanning: false;
    in property <bool> stat-has-results: true;
    in property <string> stat-scan-count: "";
    in property <string> stat-skipped: "";
    in property <string> stat-skipped-tip: "";
    callback stats-cancel();
    in property <string> stat-tree-title: "LARGEST FOLDERS";
    in property <string> stat-cache-total: "";
    in property <string> stat-cache-detail: "";
    in property <string> stat-trash-size: "";
    in property <string> stat-trash-count: "";
    callback stats-open();
    callback stats-rescan();
    callback stats-clear-thumbs();
    in property <string> status-left: "15 items · 1 hidden";
    in property <string> status-right: "";
    in property <bool> hidden-on: false;
    in property <string> crumbs: "~  ›  Pictures";
    in property <string> path-text: "/home/sky/Pictures";
    in property <string> search-query: "";
    in property <string> search-count: "";
    in property <string> search-scope: "";
    callback search-open();
    callback search-clear();
    // The toolbar's back, forward and up buttons. Back and forward dim
    // to 0.42 when the folder history has nowhere to go, and up does at
    // `/`; renders keep them lit.
    in property <bool> can-back: true;
    in property <bool> can-forward: true;
    in property <bool> can-up: true;
    callback nav-back();
    callback nav-forward();
    callback nav-up();
    in property <string> dialog-title: "";
    in property <string> dialog-body: "";
    in property <[Place]> places;
    in property <[Place]> pinned-places;
    in property <[Place]> device-places;
    in property <[Place]> trash-places;
    in property <[Row]> files;
    // The sorted list column (0 Name, 1 Size, 2 Type, 3 Modified).
    in property <int> sort-column: 0;
    in property <bool> sort-desc: false;
    callback sort-by(int);
    // Scroll offsets, kept across live refreshes and reset on navigation.
    in-out property <length> list-scroll: 0px;
    in-out property <length> grid-scroll: 0px;
    in property <[GridLine]> grid-rows;
    in property <string> toast-text: "";
    in property <[string]> toast-details;
    /// Whether the toast has details or a pinned line under its headline;
    /// set with them by `set_toast_rows`.
    in property <bool> toast-has-details: true;
    /// The hairline under an open toast's headline; only when it has
    /// details to separate.
    out property <bool> toast-divider: (overlay == "skipped-details" || overlay == "toast-details" || toast-open)
        && toast-has-details;
    in property <string> toast-pin: "";
    in property <int> toast-more: 0;
    in property <bool> toast-expanded: false;
    // "" neutral, "warning" partial move, "danger" refused up front.
    in property <string> toast-tone: "";
    // Set from Rust by `app::toast_glyph`.
    in property <string> toast-glyph: "󰄬";
    in property <string> refusal-title;
    in property <[RefusalLine]> refusal-lines;
    // False when a folder can't be read: only Close is offered.
    in property <bool> refusal-can-copy: true;
    in property <string> refusal-body: "";
    in property <string> conflict-replace-label: "Replace";
    in property <bool> conflict-existing-folder: false;
    in property <bool> conflict-incoming-folder: false;
    in property <string> refusal-dismiss: "Cancel";
    // Lines with a note under the path; each adds a row of height.
    in property <int> refusal-notes: 0;
    // How many items were refused; above one the list groups by item.
    in property <int> refusal-lines-items: 1;
    // The live conflict dialog. Defaults match the design render.
    in property <string> conflict-title: "SANDISK already has \"dune-sunset-0412.jpg\"";
    in property <string> conflict-name: "dune-sunset-0412.jpg";
    in property <string> conflict-kind: "JPEG image";
    in property <string> conflict-existing-size: "6.2 MB";
    in property <string> conflict-existing-date: "2026-10-12 21:40";
    in property <string> conflict-existing-badge2: "";
    in property <string> conflict-existing-badge: "Larger";
    in property <string> conflict-incoming-size: "4.1 MB";
    in property <string> conflict-incoming-date: "2026-10-30 18:58";
    in property <string> conflict-incoming-badge2: "";
    in property <string> conflict-incoming-badge: "Newer";
    in property <string> conflict-hint: "Keep both saves it as dune-sunset-0412 (2).jpg";
    in property <string> conflict-note: "";
    in property <string> conflict-apply-label: "Apply to all 14 conflicts";
    in property <bool> conflict-apply: false;
    // Interactive window. Dialog buttons are numbered left to right and the
    // focused one carries the ring; Tab, arrows, Enter, and Esc drive them.
    in property <int> dialog-focus: 0;
    // The danger button unlocks 600ms after the delete dialog opens.
    in property <bool> danger-armed: false;
    in property <string> confirm-noun: "3 items";
    // Lines in confirm-names, at most six: five names and "and N more".
    in property <int> confirm-names-count: 3;
    in property <string> confirm-names: "dune-sunset-0412.jpg\ndune-sunset-0413.jpg\nspeeder-run.mp4";
    in property <bool> job-on: false;
    in property <string> job-glyph: "󰆏";
    in property <string> job-label;
    in property <string> job-detail;
    in property <float> job-amount;
    in property <bool> toast-on: false;
    in property <string> toast-action: "";
    in property <bool> toast-open: false;
    // "Copy 2 items to raw-exports" while a drag is over a folder.
    in property <string> drag-label: "";
    in property <string> drag-glyph: "󰆏";
    callback key(string, bool, bool, bool) -> bool;
    // Row index, 0 down / 1 move / 2 up, rows from the pressed row, moved
    // far enough to be a drag, Ctrl, Shift.
    callback row-pointer(int, int, int, bool, bool, bool);
    // A grid tile's press/drag: line start, column, kind, dx, dy, far, ctrl, shift.
    callback tile-pointer(int, int, int, int, int, bool, bool, bool);
    callback row-open(int);
    /// A sidebar row: section 0 pinned, 1 devices, 2 trash.
    callback place-open(int, int);
    callback dialog-button(int);
    callback job-cancel();
    callback toast-link();
    callback toast-expand();
    forward-focus: keys;

    title: "Robin";
    // The smallest window every view is laid out for (DESIGN §2,
    // Resizing). The harness frame is a theme swatch, not a view.
    min-width: harness ? 0px : 480px;
    min-height: harness ? 0px : 360px;
    default-font-family: "JetBrainsMono Nerd Font";
    default-font-size: 12px;
    background: bg;

    property <length> side-row: compact ? 26px : 30px;
    property <length> toolbar-h: compact ? 40px : 46px;
    property <length> icon-box: compact ? 28px : 34px;
    property <length> status-h: compact ? 22px : 26px;
    // Below 720px the sidebar folds to its icon rail on its own.
    property <bool> rail-on: collapsed || root.width < 720px;
    property <length> side-w: rail-on ? 52px : 232px;
    property <color> hairline: text.with-alpha(0.12);
    property <color> hover: text.with-alpha(0.06);
    property <color> selected: accent.with-alpha(0.18);
    property <color> selected-active: accent.with-alpha(0.28);
    property <color> divider: line;

    keys := FocusScope {
        key-pressed(e) => {
            if root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt) {
                return accept;
            }
            return reject;
        }
    }

    if harness: VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;
        Text { text: "󰋜"; font-size: 14px; color: accent; }
        Text { text: label; font-size: 18px; font-weight: 700; color: text; }
        Text { text: "in development"; font-size: 11px; color: muted; }
        Rectangle {
            background: surface;
            height: 30px;
            border-radius: 6px;
            border-width: 1px;
            border-color: hairline;
            HorizontalLayout {
                padding-left: 8px;
                Text { text: label; font-size: 12px; color: text; vertical-alignment: center; }
            }
        }
    }

    if !harness: HorizontalLayout {
        Rectangle {
            width: side-w;
            vertical-stretch: 1;
            background: surface;
            VerticalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 0px;
                if !rail-on && pinned-places.length > 0: HorizontalLayout {
                    Rectangle { width: 12px; }
                    Text {
                        text: "PINNED";
                        height: 24px;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1px;
                        color: muted;
                        vertical-alignment: center;
                    }
                }
                for place[i] in pinned-places: SideRow {
                    clicked => { root.place-open(0, i); }
                    glyph: place.glyph;
                    name: place.name;
                    count: place.count;
                    picked: place.selected;
                    rail: root.rail-on;
                    side-row: root.side-row;
                    ink: root.text;
                    muted: root.muted;
                    accent: root.accent;
                    selected-bg: root.selected;
                }
                Rectangle { height: 8px; }
                if !rail-on && device-places.length > 0: HorizontalLayout {
                    Rectangle { width: 12px; }
                    Text {
                        text: "DEVICES";
                        height: 24px;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1px;
                        color: muted;
                        vertical-alignment: center;
                    }
                }
                // The highlight wraps the label and its usage bar together.
                for place[i] in device-places: Rectangle {
                    border-radius: 6px;
                    background: place.selected ? root.selected : transparent;
                    border-width: place.selected ? 1px : 0px;
                    border-color: root.accent;
                    TouchArea { clicked => { root.place-open(1, i); } }
                    VerticalLayout {
                    padding-bottom: !root.rail-on && place.usage >= 0 ? 4px : 0px;
                    spacing: 1px;
                    SideRow {
                        clicked => { root.place-open(1, i); }
                        glyph: place.glyph;
                        name: place.name;
                        count: place.count;
                        picked: false;
                        rail: root.rail-on;
                        side-row: root.side-row;
                        ink: root.text;
                        muted: root.muted;
                        accent: root.accent;
                        selected-bg: root.selected;
                        dot: place.usage >= 0 && place.level > 0;
                        dot-color: place.level == 2 ? root.danger : root.warning;
                    }
                    if !root.rail-on && place.usage >= 0: Rectangle {
                        height: 4px;
                        Rectangle {
                            x: 38px;
                            y: 0px;
                            width: parent.width - 38px - 8px;
                            height: 3px;
                            border-radius: 2px;
                            background: root.text.with-alpha(0.12);
                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: parent.width * place.usage;
                                height: parent.height;
                                border-radius: 2px;
                                background: place.level == 2 ? root.danger : place.level == 1 ? root.warning : root.accent;
                            }
                        }
                    }
                }
                    }
                Rectangle { height: 8px; }
                if !rail-on && trash-places.length > 0: HorizontalLayout {
                    Rectangle { width: 12px; }
                    Text {
                        text: "TRASH";
                        height: 24px;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1px;
                        color: muted;
                        vertical-alignment: center;
                    }
                }
                for place[i] in trash-places: SideRow {
                    clicked => { root.place-open(2, i); }
                    glyph: place.glyph;
                    name: place.name;
                    count: place.count;
                    picked: place.selected;
                    rail: root.rail-on;
                    side-row: root.side-row;
                    ink: root.text;
                    muted: root.muted;
                    accent: root.accent;
                    selected-bg: root.selected;
                }
                Rectangle { vertical-stretch: 1; }
                SideRow {
                    glyph: "󰄨";
                    name: "Statistics";
                    count: "";
                    picked: root.stats-mode != "";
                    clicked => { root.stats-open(); }
                    rail: root.rail-on;
                    side-row: root.side-row;
                    ink: root.text;
                    muted: root.muted;
                    accent: root.accent;
                    selected-bg: root.selected;
                }
            }
        }
        Rectangle { width: 1px; background: divider; }
        VerticalLayout {
            Rectangle {
                height: toolbar-h;
                background: bg;
                property <length> iy: (self.height - icon-box) / 2;
                property <length> nav-w: icon-box * 3 + 4px;
                property <length> right-w: icon-box * 4 + 18px;
                property <length> crumb-x: 8px + nav-w + 12px;
                property <length> right-x: self.width - 8px - right-w;
                if nav-busy || reading: Rectangle {
                    y: parent.height - 2px;
                    height: 2px;
                    clip: true;
                    property <float> t: nav-phase >= 0 ? nav-phase : Math.mod(animation-tick() / 1ms, 1400) / 1400;
                    Rectangle {
                        width: parent.width * 0.3;
                        x: (parent.width * 1.3) * t - self.width;
                        background: accent;
                    }
                }
                Rectangle {
                    x: 8px;
                    y: iy;
                    width: icon-box;
                    height: icon-box;
                    border-radius: 3px;
                    opacity: can-back ? 1 : 0.42;
                    Text { text: "󰁍"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        enabled: can-back;
                        mouse-cursor: pointer;
                        clicked => { root.nav-back(); }
                    }
                }
                Rectangle {
                    x: 8px + icon-box + 2px;
                    y: iy;
                    width: icon-box;
                    height: icon-box;
                    border-radius: 3px;
                    opacity: can-forward ? 1 : 0.42;
                    Text { text: "󰁔"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        enabled: can-forward;
                        mouse-cursor: pointer;
                        clicked => { root.nav-forward(); }
                    }
                }
                Rectangle {
                    x: 8px + (icon-box + 2px) * 2;
                    y: iy;
                    width: icon-box;
                    height: icon-box;
                    border-radius: 3px;
                    opacity: can-up ? 1 : 0.42;
                    Text { text: "󰁝"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea {
                        enabled: can-up;
                        mouse-cursor: pointer;
                        clicked => { root.nav-up(); }
                    }
                }
                Rectangle {
                    x: crumb-x;
                    y: (parent.height - 30px) / 2;
                    width: right-x - 12px - crumb-x;
                    height: 30px;
                    border-radius: 6px;
                    background: surface;
                    border-width: overlay == "path-invalid" ? 2px : 1px;
                    border-color: overlay == "path-invalid" ? danger : overlay == "path-edit" ? accent : hairline;
                    if overlay != "search" && overlay != "path-edit" && overlay != "path-invalid" && overlay != "path-complete": Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: crumbs;
                        font-size: 12px;
                        color: muted;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                    if overlay == "search": HorizontalLayout {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        spacing: 6px;
                        Text { text: "󰍉"; font-size: 13px; color: muted; vertical-alignment: center; }
                        Text { text: search-query; font-size: 12px; color: text; vertical-alignment: center; }
                        Text {
                            text: search-scope;
                            font-size: 11px;
                            color: muted;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text { text: search-count; font-size: 11px; color: muted; vertical-alignment: center; }
                        Rectangle {
                            width: 18px;
                            Text { text: "×"; font-size: 14px; color: muted; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.search-clear(); } }
                        }
                    }
                    if overlay == "path-edit" || overlay == "path-invalid" || overlay == "path-complete": Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: path-text;
                        font-size: 12px;
                        color: text;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }
                Rectangle {
                    x: right-x;
                    y: iy;
                    width: icon-box;
                    height: icon-box;
                    border-radius: 3px;
                    background: overlay == "search" ? accent : transparent;
                    Text { text: "󰍉"; font-size: 16px; color: overlay == "search" ? surface : text; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.search-open(); } }
                }
                Rectangle {
                    x: right-x + icon-box + 6px;
                    y: (parent.height - 20px) / 2;
                    width: 1px;
                    height: 20px;
                    background: text.with-alpha(0.14);
                }
                Rectangle {
                    x: right-x + icon-box + 14px;
                    y: iy;
                    width: icon-box;
                    height: icon-box;
                    border-radius: 3px;
                    background: !grid ? selected : transparent;
                    Text { text: "󰈚"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.set-grid(false); } }
                }
                Rectangle {
                    x: right-x + icon-box * 2 + 16px;
                    y: iy;
                    width: icon-box;
                    height: icon-box;
                    border-radius: 3px;
                    background: grid ? selected : transparent;
                    Text { text: "󰕰"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.set-grid(true); } }
                }
                Rectangle {
                    x: right-x + icon-box * 3 + 18px;
                    y: iy;
                    width: icon-box;
                    height: icon-box;
                    border-radius: 3px;
                    Text { text: "󰇘"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            Rectangle { height: 1px; background: divider; }

            Rectangle {
                vertical-stretch: 1;
                background: bg;
                if state == "files" && !grid: VerticalLayout {
                    opacity: nav-busy ? 0.6 : 1;
                    if trash-view: Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 8px;
                            Text {
                                text: "Items here can be restored to where they were deleted from.";
                                font-size: 11px;
                                color: muted;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Rectangle {
                                width: restore-label.preferred-width + 32px;
                                height: 32px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: line;
                                opacity: trash-can-restore ? 1 : 0.42;
                                restore-label := Text { text: "Restore"; font-size: 12px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea { enabled: trash-can-restore; clicked => { root.trash-restore(); } }
                            }
                            Rectangle {
                                width: empty-label.preferred-width + 32px;
                                height: 32px;
                                border-radius: 6px;
                                // Outline only: solid danger is kept for the
                                // confirm dialog's "Delete permanently".
                                border-width: 1px;
                                border-color: danger;
                                background: empty-touch.has-hover ? danger.with-alpha(0.12) : transparent;
                                empty-label := Text { text: "Empty Trash"; font-size: 12px; color: danger; horizontal-alignment: center; vertical-alignment: center; }
                                empty-touch := TouchArea { clicked => { root.trash-empty(); } }
                            }
                        }
                    }
                    if trash-view: Rectangle { height: 1px; background: divider; }
                    if trash-view && trash-note != "": Rectangle {
                        height: 32px;
                        background: warning.with-alpha(0.12);
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 8px;
                            Text { text: "󰀦"; font-size: 13px; color: warning; vertical-alignment: center; }
                            Text {
                                text: trash-note;
                                font-size: 11px;
                                color: text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                        }
                    }
                    Rectangle {
                        height: 26px;
                        HeaderCell {
                            label: "NAME";
                            column: 0;
                            sorted: root.sort-column == 0;
                            desc: root.sort-desc;
                            x: Columns.name-x;
                            width: Columns.name-w(parent.width);
                            align-right: false;
                            height: parent.height;
                            accent: accent;
                            muted: muted;
                            clicked => { root.sort-by(0); }
                        }
                        if !trash-view: HeaderCell {
                            label: "SIZE";
                            column: 1;
                            sorted: root.sort-column == 1;
                            desc: root.sort-desc;
                            x: Columns.size-x(parent.width);
                            width: Columns.size-w;
                            align-right: true;
                            height: parent.height;
                            accent: accent;
                            muted: muted;
                            clicked => { root.sort-by(1); }
                        }
                        if trash-view || !Columns.no-type: HeaderCell {
                            label: trash-view ? "ORIGINAL LOCATION" : "TYPE";
                            column: 2;
                            sorted: !trash-view && root.sort-column == 2;
                            desc: root.sort-desc;
                            x: trash-view ? Columns.size-x(parent.width) : Columns.type-x(parent.width);
                            width: trash-view ? Columns.mod-x(parent.width) - Columns.size-x(parent.width) - 8px : Columns.type-w;
                            align-right: false;
                            height: parent.height;
                            accent: accent;
                            muted: muted;
                            // Trash rows sort by name; these columns aren't the file's own.
                            clicked => { if !trash-view { root.sort-by(2); } }
                        }
                        HeaderCell {
                            label: trash-view ? "DELETED" : "MODIFIED";
                            column: 3;
                            sorted: !trash-view && root.sort-column == 3;
                            desc: root.sort-desc;
                            x: Columns.mod-x(parent.width);
                            width: Columns.mod-w;
                            align-right: false;
                            height: parent.height;
                            accent: accent;
                            muted: muted;
                            clicked => { if !trash-view { root.sort-by(3); } }
                        }
                    }
                    Rectangle { height: 1px; background: divider; }
                    ListView {
                        vertical-stretch: 1;
                        viewport-y <=> root.list-scroll;
                        for row[i] in files: Rectangle {
                            width: parent.width;
                            height: row-h;
                            // drop_target: accent@12% under a dashed accent
                            // stroke; drop_target_invalid: danger@10% and a
                            // solid danger stroke (DESIGN §0).
                            background: row.drop ? accent.with-alpha(0.12) : row.drop-refused ? danger.with-alpha(0.10) : row.selected ? selected-active : row.hovered ? hover : transparent;
                            border-radius: 6px;
                            border-width: row.drop-refused ? 2px : 0px;
                            border-color: danger;
                            opacity: row.cut ? 0.5 : 1;
                            if row.drop: DashedFrame { width: parent.width; height: parent.height; ink: root.accent; }
                            TouchArea {
                                mouse-cursor: row.drop-refused ? MouseCursor.not-allowed : MouseCursor.default;
                                pointer-event(e) => {
                                    if e.button == PointerEventButton.left || e.kind == PointerEventKind.move {
                                        root.row-pointer(
                                            i,
                                            e.kind == PointerEventKind.down ? 0 : e.kind == PointerEventKind.up ? 2 : 1,
                                            floor(self.mouse-y / row-h),
                                            self.pressed && (abs(self.mouse-x - self.pressed-x) > 6px || abs(self.mouse-y - self.pressed-y) > 6px),
                                            e.modifiers.control,
                                            e.modifiers.shift);
                                    }
                                }
                                double-clicked => { root.row-open(i); }
                            }
                            Text {
                                text: row.glyph;
                                x: Columns.pad;
                                y: 0px;
                                width: Columns.icon-w;
                                height: parent.height;
                                font-size: 14px;
                                color: row.role == 2 ? danger : row.role == 3 ? warning : row.role == 1 ? accent : row.role == 4 ? muted : text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if marks[i].runs.length > 0: HorizontalLayout {
                                x: Columns.name-x;
                                width: Columns.name-w(parent.width);
                                height: parent.height;
                                opacity: row.hidden ? 0.6 : 1;
                                for run in marks[i].runs: Text {
                                    text: run.text;
                                    font-size: 12px;
                                    font-weight: row.selected ? 700 : 400;
                                    color: run.hit ? accent : text;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if marks[i].runs.length == 0: Text {
                                text: labels[i] != "" ? labels[i] : row.name;
                                x: Columns.name-x;
                                y: 0px;
                                width: Columns.name-w(parent.width);
                                height: parent.height;
                                font-size: 12px;
                                font-weight: row.selected ? 700 : 400;
                                color: text;
                                opacity: row.hidden ? 0.6 : 1;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: row.size;
                                x: Columns.size-x(parent.width);
                                y: 0px;
                                width: Columns.size-w;
                                height: parent.height;
                                font-size: 12px;
                                color: muted;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: row.kind;
                                visible: trash-view || !Columns.no-type;
                                x: trash-view ? Columns.size-x(parent.width) : Columns.type-x(parent.width);
                                y: 0px;
                                width: trash-view ? Columns.mod-x(parent.width) - Columns.size-x(parent.width) - 8px : Columns.type-w;
                                height: parent.height;
                                font-size: 12px;
                                color: muted;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: row.modified;
                                x: Columns.mod-x(parent.width);
                                y: 0px;
                                width: Columns.mod-w;
                                height: parent.height;
                                font-size: 12px;
                                color: muted;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
                if state == "files" && grid: ListView {
                    opacity: nav-busy ? 0.6 : 1;
                    vertical-stretch: 1;
                    viewport-y <=> root.grid-scroll;
                    for line in grid-rows: HorizontalLayout {
                        // Centre the columns so the spare width splits evenly.
                        padding-left: max(16px, (root.content-w - root.grid-columns * root.tile - (root.grid-columns - 1) * 8px) / 2);
                        padding-right: 0px;
                        alignment: start;
                        padding-top: 8px;
                        padding-bottom: 0px;
                        spacing: 8px;
                        height: tile + 60px;
                        if line.n > 0: Tile {
                            glyph: line.g0; name: line.n0; role: line.r0; badge: line.b0; picked: line.s0; hot: line.h0; faded: line.f0;
                            pointer(kind, dx, dy, far, ctrl, shift) => { root.tile-pointer(line.first, 0, kind, dx, dy, far, ctrl, shift); }
                            open => { root.row-open(line.first + 0); }
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 1: Tile {
                            glyph: line.g1; name: line.n1; role: line.r1; badge: line.b1; picked: line.s1; hot: line.h1; faded: line.f1;
                            pointer(kind, dx, dy, far, ctrl, shift) => { root.tile-pointer(line.first, 1, kind, dx, dy, far, ctrl, shift); }
                            open => { root.row-open(line.first + 1); }
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 2: Tile {
                            glyph: line.g2; name: line.n2; role: line.r2; badge: line.b2; picked: line.s2; hot: line.h2; faded: line.f2;
                            pointer(kind, dx, dy, far, ctrl, shift) => { root.tile-pointer(line.first, 2, kind, dx, dy, far, ctrl, shift); }
                            open => { root.row-open(line.first + 2); }
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 3: Tile {
                            glyph: line.g3; name: line.n3; role: line.r3; badge: line.b3; picked: line.s3; hot: line.h3; faded: line.f3;
                            pointer(kind, dx, dy, far, ctrl, shift) => { root.tile-pointer(line.first, 3, kind, dx, dy, far, ctrl, shift); }
                            open => { root.row-open(line.first + 3); }
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 4: Tile {
                            glyph: line.g4; name: line.n4; role: line.r4; badge: line.b4; picked: line.s4; hot: line.h4; faded: line.f4;
                            pointer(kind, dx, dy, far, ctrl, shift) => { root.tile-pointer(line.first, 4, kind, dx, dy, far, ctrl, shift); }
                            open => { root.row-open(line.first + 4); }
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 5: Tile {
                            glyph: line.g5; name: line.n5; role: line.r5; badge: line.b5; picked: line.s5; hot: line.h5; faded: line.f5;
                            pointer(kind, dx, dy, far, ctrl, shift) => { root.tile-pointer(line.first, 5, kind, dx, dy, far, ctrl, shift); }
                            open => { root.row-open(line.first + 5); }
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                    }
                }
                // The first read hasn't landed: file-icon rows stand in for
                // the spec's skeleton rows (an accepted deviation) while the
                // bar under the toolbar runs.
                if state == "loading": VerticalLayout {
                    alignment: start;
                    Rectangle { height: 27px; }
                    for i in 12: Rectangle {
                        height: row-h;
                        Text {
                            text: "󰈔";
                            x: Columns.pad;
                            width: Columns.icon-w;
                            height: parent.height;
                            font-size: 14px;
                            color: muted.with-alpha(0.5);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if state == "empty" || state == "trash-empty" || state == "denied" || state == "unmounted" || state == "ejected" || state == "nosearch": VerticalLayout {
                    alignment: center;
                    width: parent.width;
                    Text {
                        text: state == "empty" ? "󰉖" : state == "trash-empty" ? "󰩺" : state == "denied" ? "󰌾" : state == "nosearch" ? "󰍉" : "󰕓";
                        font-size: 64px;
                        color: state == "denied" || state == "ejected" ? warning.with-alpha(0.6) : muted.with-alpha(0.6);
                        horizontal-alignment: center;
                        width: parent.width;
                    }
                    Rectangle { height: 12px; }
                    Text {
                        text: state == "empty" ? "This folder is empty" : state == "trash-empty" ? "Trash is empty" : state == "denied" ? state-title : state == "unmounted" ? "SANDISK is not mounted" : state == "ejected" ? "SANDISK was removed" : state-title;
                        font-size: 18px;
                        font-weight: 700;
                        color: text;
                        horizontal-alignment: center;
                        width: parent.width;
                    }
                    Rectangle { height: 6px; }
                    Text {
                        text: state == "empty" ? "Drop files here or press Ctrl+N" : state == "trash-empty" ? "Files you move to the trash wait here until you empty it." : state == "denied" ? state-note : state == "nosearch" ? state-note : "";
                        font-size: 11px;
                        color: muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        width: parent.width;
                    }
                    // The state's actions, 16 below the body (DESIGN §3).
                    if state != "trash-empty": Rectangle { height: 16px; }
                    if state != "trash-empty": HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        if state == "empty": StateButton {
                            label: "New folder";
                            ink: root.text; line-ink: root.line; accent: root.accent; on-accent: root.on-accent; hover-bg: root.hover;
                            clicked => { root.state-action("new-folder"); }
                        }
                        if state == "denied": StateButton {
                            label: "Open as admin…";
                            ink: root.text; line-ink: root.line; accent: root.accent; on-accent: root.on-accent; hover-bg: root.hover;
                            clicked => { root.state-action("admin"); }
                        }
                        if state == "denied": StateButton {
                            label: "Go back";
                            ink: root.text; line-ink: root.line; accent: root.accent; on-accent: root.on-accent; hover-bg: root.hover;
                            clicked => { root.state-action("back"); }
                        }
                        if state == "unmounted": StateButton {
                            label: "Mount";
                            primary: true;
                            ink: root.text; line-ink: root.line; accent: root.accent; on-accent: root.on-accent; hover-bg: root.hover;
                            clicked => { root.state-action("mount"); }
                        }
                        if state == "ejected": StateButton {
                            label: "Go to Home";
                            ink: root.text; line-ink: root.line; accent: root.accent; on-accent: root.on-accent; hover-bg: root.hover;
                            clicked => { root.state-action("home"); }
                        }
                        if state == "nosearch" && search-hidden-offer: StateButton {
                            label: "Search hidden files";
                            ink: root.text; line-ink: root.line; accent: root.accent; on-accent: root.on-accent; hover-bg: root.hover;
                            clicked => { root.state-action("search-hidden"); }
                        }
                        if state == "nosearch": StateButton {
                            label: "Clear";
                            ink: root.text; line-ink: root.line; accent: root.accent; on-accent: root.on-accent; hover-bg: root.hover;
                            clicked => { root.state-action("clear"); }
                        }
                    }
                }
            }

            if job-on: Rectangle {
                height: 44px;
                background: surface;
                JobRow {
                    row-h: 44px;
                    glyph: job-glyph;
                    label: job-label;
                    detail: job-detail;
                    amount: job-amount;
                    failed: false;
                    cancel-link: true;
                    cancel => { root.job-cancel(); }
                    ink: root.text;
                    muted-ink: root.muted;
                    accent-ink: root.accent;
                    danger-ink: root.danger;
                }
            }
            if overlay == "progress-1" || overlay == "progress-3" || overlay == "progress-error": Rectangle {
                height: overlay == "progress-3" ? 116px : 44px;
                background: surface;
                VerticalLayout {
                    alignment: start;
                    JobRow {
                        row-h: 44px;
                        glyph: "󰆏";
                        label: "Copying 1 204 files to SANDISK";
                        detail: "2.1 / 6.4 GB · 84 MB/s · 52s left";
                        amount: overlay == "progress-error" ? 0.4 : 0.33;
                        failed: overlay == "progress-error";
                        ink: root.text;
                        muted-ink: root.muted;
                        accent-ink: root.accent;
                        danger-ink: root.danger;
                    }
                    if overlay == "progress-3": JobRow {
                        row-h: 36px;
                        glyph: "󰪹";
                        label: "Moving 12 files to archive";
                        detail: "840 MB / 1.2 GB · 40 MB/s";
                        amount: 0.7;
                        failed: false;
                        ink: root.text;
                        muted-ink: root.muted;
                        accent-ink: root.accent;
                        danger-ink: root.danger;
                    }
                    if overlay == "progress-3": JobRow {
                        row-h: 36px;
                        glyph: "󰩺";
                        label: "Moving 3 items to trash";
                        detail: "12 MB";
                        amount: 0.15;
                        failed: false;
                        ink: root.text;
                        muted-ink: root.muted;
                        accent-ink: root.accent;
                        danger-ink: root.danger;
                    }
                }
            }

            Rectangle { height: 1px; background: divider; }
            Rectangle {
                height: status-h;
                background: bg;
                // Just the hidden-files eye: density has no control; the app
                // is always comfortable.
                property <length> toggles-w: 22px;
                property <length> free-w: root.width < 720px ? 96px : 188px;
                Text {
                    text: status-left;
                    x: 12px;
                    y: 0px;
                    width: parent.width - 32px - free-w - toggles-w;
                    height: parent.height;
                    font-size: 11px;
                    color: muted;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: "󰈈";
                    x: parent.width - 12px - toggles-w;
                    width: 22px;
                    height: parent.height;
                    font-size: 12px;
                    color: hidden-on ? accent : muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    TouchArea { clicked => { root.toggle-hidden(); } }
                }
                Text {
                    text: root.width < 720px && status-free-short != "" ? status-free-short : status-right;
                    x: parent.width - 12px - free-w - toggles-w - 8px;
                    y: 0px;
                    width: free-w;
                    height: parent.height;
                    font-size: 11px;
                    color: muted;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    if !harness && (toast-on || overlay == "skipped" || overlay == "skipped-details" || overlay == "toast-details"): Rectangle {
        property <bool> open: overlay == "skipped-details" || overlay == "toast-details" || toast-open;
        property <color> tone: toast-tone == "warning" ? warning : toast-tone == "danger" ? danger : muted;
        property <length> line-h: 20px;
        // Fit the line, 520px to 800px, and never wider than the window.
        width: min(max(520px, min(800px, toast-line.preferred-width + 42px + 120px)), parent.width - side-w - 32px);
        // A pinned line, then up to seven items and "+N more"; expanded,
        // the items scroll past 240px so the toast never covers the list.
        property <length> pin-h: toast-pin != "" ? line-h : 0px;
        property <length> rows-h: toast-details.length * line-h + (toast-more > 0 ? line-h : 0px);
        // Never taller than the space between the toolbar and the toast's
        // own spot above the status bar; the rest scrolls.
        property <length> room: max(0px, parent.height - toolbar-h - status-h - 32px - 52px - 24px - pin-h);
        property <length> list-h: min(toast-expanded ? min(240px, rows-h) : rows-h, room);
        height: open ? 52px + 12px + pin-h + list-h + 12px : 52px;
        x: side-w + (parent.width - side-w - self.width) / 2;
        y: parent.height - status-h - 16px - self.height;
        background: surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: toast-tone == "" || toast-tone == "info" ? hairline : tone;
        drop-shadow-blur: 16px;
        drop-shadow-color: #000000.with-alpha(0.35);
        if toast-tone == "warning" || toast-tone == "danger": Rectangle {
            x: 0px;
            y: 0px;
            width: 4px;
            height: parent.height;
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
            background: tone;
        }
        Text {
            text: toast-glyph;
            x: 16px;
            y: 0px;
            width: 18px;
            height: 52px;
            font-size: 14px;
            color: tone;
            vertical-alignment: center;
        }
        toast-line := Text {
            text: toast-text;
            x: 42px;
            y: 0px;
            width: parent.width - 42px - 120px;
            height: 52px;
            font-size: 13px;
            color: text;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            text: toast-details.length == 0 ? toast-action : open ? "Hide details" : "Details";
            x: parent.width - 16px - self.width;
            y: 0px;
            width: 96px;
            height: 52px;
            font-size: 12px;
            color: accent;
            horizontal-alignment: right;
            vertical-alignment: center;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toast-link(); }
            }
        }
        if toast-divider: Rectangle {
            x: 16px;
            y: 52px;
            width: parent.width - 32px;
            height: 1px;
            background: hairline;
        }
        if open && toast-pin != "": Text {
            x: 42px;
            y: 52px + 12px;
            width: parent.width - 58px;
            height: line-h;
            text: toast-pin;
            font-size: 11px;
            color: text;
            overflow: elide;
            vertical-alignment: center;
        }
        if open: Flickable {
            x: 42px;
            y: 52px + 12px + pin-h;
            width: parent.width - 58px;
            height: list-h;
            viewport-height: rows-h;
            VerticalLayout {
                spacing: 0px;
                for detail in toast-details: Text {
                    text: detail;
                    height: line-h;
                    font-size: 11px;
                    color: muted;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if toast-more > 0: Text {
                    text: "+" + toast-more + " more";
                    height: line-h;
                    font-size: 11px;
                    color: muted;
                    vertical-alignment: center;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toast-expand(); }
                    }
                }
            }
        }
    }

    if !harness && (overlay == "trash" || overlay == "trash-no" || overlay == "delete" || overlay == "move-refused" || overlay == "menu-file" || overlay == "menu-bg"): Rectangle {
        // Menus open over the window as it is; dialogs get the scrim.
        background: overlay == "menu-file" || overlay == "menu-bg" ? transparent : #000000.with-alpha(0.6);
        if overlay == "delete" || overlay == "trash" || overlay == "trash-no": Rectangle {
            // 440 wide, or 16 clear of each window edge when that is less.
            width: min(440px, parent.width - 32px);
            // Title, note, up to six name lines ("and N more"), the trash
            // confirm's "Don't ask again" row, buttons. A short window
            // scrolls the names; the buttons always show.
            height: min(150px + max(1, confirm-names-count) * 15px + (overlay == "trash" ? 26px : 0px), parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            // The danger top bar stays inside the radius.
            clip: true;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                if overlay == "delete": HorizontalLayout {
                    spacing: 8px;
                    Text { text: "󰀦"; width: 20px; height: 20px; font-size: 20px; color: danger; horizontal-alignment: center; vertical-alignment: center; }
                    Text { text: "Permanently delete \{confirm-noun}?"; font-size: 13px; font-weight: 700; color: text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                }
                if overlay == "trash-no": HorizontalLayout {
                    spacing: 8px;
                    Text { text: "󰀦"; width: 20px; height: 20px; font-size: 20px; color: warning; horizontal-alignment: center; vertical-alignment: center; }
                    Text { text: "This drive has no trash"; font-size: 13px; font-weight: 700; color: text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                }
                if overlay == "trash": Text {
                    text: "Move \{confirm-noun} to trash?";
                    font-size: 13px;
                    font-weight: 700;
                    color: text;
                    overflow: elide;
                }
                Text {
                    text: overlay == "delete" ? "This can't be undone." : overlay == "trash-no" ? "Robin will not copy these files home." : "You can restore them from Trash.";
                    font-size: 12px;
                    color: muted;
                    overflow: elide;
                }
                Flickable {
                    vertical-stretch: 1;
                    min-height: 0px;
                    viewport-height: names-text.preferred-height;
                    names-text := Text { text: confirm-names; font-size: 11px; color: muted; width: parent.width; overflow: elide; }
                }
                if overlay == "trash": HorizontalLayout {
                    spacing: 8px;
                    height: 18px;
                    alignment: start;
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        y: 2px;
                        border-radius: 2px;
                        border-color: dialog-focus == 2 ? accent : line;
                        border-width: dialog-focus == 2 ? 2px : 1px;
                        background: trash-dont-ask ? accent : transparent;
                        if trash-dont-ask: Text { text: "󰄬"; font-size: 12px; color: on-accent; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Don't ask again"; font-size: 12px; color: text; vertical-alignment: center; }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Rectangle {
                        width: 88px;
                        height: 32px;
                        border-radius: 6px;
                        border-width: dialog-focus == 0 ? 2px : 1px;
                        border-color: dialog-focus == 0 ? accent : line;
                        Text { text: "Cancel"; font-size: 12px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.dialog-button(0); } }
                    }
                    Rectangle {
                        // Grows to fit its label with 16px either side.
                        width: max(88px, confirm-label.preferred-width + 32px);
                        height: 32px;
                        border-radius: 6px;
                        background: overlay == "delete" || overlay == "trash-no" ? danger : accent;
                        opacity: overlay == "delete" && !danger-armed ? 0.42 : 1;
                        border-width: dialog-focus == 1 ? 2px : 0px;
                        border-color: text;
                        TouchArea { clicked => { root.dialog-button(1); } }
                        confirm-label := Text {
                            text: overlay == "delete" || overlay == "trash-no" ? "Delete permanently" : "Move to Trash";
                            font-size: 12px;
                            color: overlay == "delete" || overlay == "trash-no" ? on-danger : on-accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            if overlay == "trash": TouchArea {
                x: 20px;
                y: parent.height - 20px - 32px - 8px - 18px;
                width: 160px;
                height: 18px;
                clicked => { root.dialog-button(2); }
            }
            if overlay == "delete": Rectangle { x: 0px; y: 0px; width: parent.width; height: 3px; background: danger; }
        }
        if overlay == "move-refused": Rectangle {
            width: min(460px, parent.width - 32px);
            // The list shows up to 14 lines and scrolls past that, or past
            // what a short window leaves once the buttons are placed.
            property <length> list-h: (refusal-lines.length + refusal-notes) * 18px;
            height: min(160px + min(list-h, 252px), parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                Text { text: refusal-title; font-size: 13px; font-weight: 700; color: text; wrap: word-wrap; }
                Text {
                    text: refusal-body != "" ? refusal-body : refusal-can-copy ? refusal-lines-items > 1 ? "Robin can copy them there instead and leave the originals where they are." : "Robin can copy it there instead and leave the original where it is." : "Nothing was moved.";
                    font-size: 12px;
                    color: muted;
                    wrap: word-wrap;
                }
                Flickable {
                    vertical-stretch: 1;
                    min-height: 0px;
                    preferred-height: min(list-h, 252px);
                    viewport-height: list-h;
                    VerticalLayout {
                        for line in refusal-lines: VerticalLayout {
                            Text { text: line.path; font-size: 11px; font-weight: line.head ? 700 : 400; color: line.head ? text : muted; height: 18px; overflow: elide; x: line.head ? 0px : 12px; }
                            if line.note != "": Text { text: line.note; font-size: 11px; color: text; height: 18px; overflow: elide; x: line.head ? 12px : 24px; }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Rectangle {
                        width: 88px;
                        height: 32px;
                        border-radius: 6px;
                        border-width: dialog-focus == 0 ? 2px : 1px;
                        border-color: dialog-focus == 0 ? accent : line;
                        Text { text: refusal-dismiss; font-size: 12px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.dialog-button(0); } }
                    }
                    // Default button: filled, with the focus ring.
                    if refusal-can-copy: Rectangle {
                        width: 112px;
                        height: 32px;
                        border-radius: 6px;
                        background: accent;
                        border-width: dialog-focus == 1 ? 2px : 0px;
                        border-color: text;
                        TouchArea { clicked => { root.dialog-button(1); } }
                        Text { text: "Copy instead"; font-size: 12px; color: on-accent; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
        if overlay == "menu-file" || overlay == "menu-bg": Rectangle {
            // From the pointer: a file row, or empty space in the list.
            // Kept 8 inside the window: a menu that would run off the right
            // or bottom edge opens up or left of the pointer instead, and
            // one taller than the window scrolls.
            property <length> at-x: overlay == "menu-file" ? 280px : 620px;
            property <length> at-y: overlay == "menu-file" ? 150px : 300px;
            width: min(248px, parent.width - 16px);
            height: min(menu-list.preferred-height, parent.height - 16px);
            x: at-x + self.width + 8px <= parent.width ? at-x : max(8px, min(at-x, parent.width - 8px) - self.width);
            y: at-y + self.height + 8px <= parent.height ? at-y : max(8px, min(at-y, parent.height - 8px) - self.height);
            clip: true;
            background: surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            Flickable {
            viewport-height: menu-list.preferred-height;
            menu-list := VerticalLayout {
                width: parent.width;
                padding: 4px;
                spacing: 0px;
                for item in menu-items: Rectangle {
                    height: item.sep ? 9px : (compact ? 24px : 28px);
                    if item.sep: Rectangle {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: 1px;
                        background: divider;
                    }
                    if !item.sep: Rectangle {
                        border-radius: 6px;
                        background: item-touch.has-hover ? selected : transparent;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            Text { text: item.glyph; width: 16px; font-size: 14px; color: item.danger ? danger : muted; vertical-alignment: center; horizontal-alignment: center; }
                            Text { text: item.label; font-size: 12px; color: item.danger ? danger : text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            if item.shortcut != "": Text { text: item.shortcut; font-size: 11px; color: item.danger ? danger : muted; vertical-alignment: center; }
                            if item.sub: Text { text: "󰅂"; font-size: 12px; color: muted; vertical-alignment: center; }
                        }
                        item-touch := TouchArea { }
                    }
                }
            }
            }
        }
    }

    if !harness && (overlay == "conflict" || overlay == "conflict-all" || overlay == "conflict-live"): Rectangle {
        property <bool> live: overlay == "conflict-live";
        property <bool> apply: live ? conflict-apply : overlay == "conflict-all";
        // Design renders ring Skip; the live dialog follows the keyboard.
        property <int> f: live ? dialog-focus : 1;
        background: #000000.with-alpha(0.6);
        TouchArea { }
        Rectangle {
            // 480 wide, or 16 clear of each window edge; the two cards
            // share what is left, and the buttons stay right-aligned.
            width: min(480px, parent.width - 32px);
            height: 328px;
            x: (parent.width - self.width) / 2;
            y: max(0px, (parent.height - self.height) / 2);
            property <length> card-w: (self.width - 48px) / 2;
            background: surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            Text {
                text: conflict-title;
                x: 20px;
                y: 16px;
                width: parent.width - 40px;
                height: 22px;
                font-size: 13px;
                font-weight: 700;
                color: text;
                overflow: elide;
                vertical-alignment: center;
            }
            Rectangle {
                x: 16px;
                y: 48px;
                width: card-w;
                height: 146px;
                border-radius: 6px;
                border-width: 1px;
                border-color: hairline;
                Text { text: conflict-name; x: 8px; y: 6px; width: parent.width - 16px; height: 16px; font-size: 11px; color: text; overflow: elide; }
                if !live: Image {
                    x: 8px;
                    y: 26px;
                    width: 64px;
                    height: 64px;
                    source: @image-url("../assets/thumbs/dune-sunset-0412.jpg");
                    image-fit: cover;
                }
                if live: Text { text: conflict-existing-folder ? "󰉋" : "󰈔"; x: 8px; y: 26px; width: 64px; height: 64px; font-size: 40px; color: muted; horizontal-alignment: center; vertical-alignment: center; }
                if conflict-existing-badge != "": Rectangle { x: 8px; y: 94px; width: 52px; height: 14px; border-radius: 2px; background: accent; }
                if conflict-existing-badge != "": Text { text: conflict-existing-badge; x: 8px; y: 94px; width: 52px; height: 14px; font-size: 9px; font-weight: 700; color: on-accent; horizontal-alignment: center; vertical-alignment: center; }
                if conflict-existing-badge2 != "": Rectangle { x: 64px; y: 94px; width: 52px; height: 14px; border-radius: 2px; background: accent; }
                if conflict-existing-badge2 != "": Text { text: conflict-existing-badge2; x: 64px; y: 94px; width: 52px; height: 14px; font-size: 9px; font-weight: 700; color: on-accent; horizontal-alignment: center; vertical-alignment: center; }
                Text { text: conflict-existing-size; x: 80px; y: 28px; width: parent.width - 88px; height: 16px; font-size: 11px; color: muted; overflow: elide; }
                Text { text: conflict-existing-date; x: 80px; y: 46px; width: parent.width - 88px; height: 16px; font-size: 11px; color: muted; overflow: elide; }
                Text { text: conflict-kind; x: 80px; y: 64px; width: parent.width - 88px; height: 16px; font-size: 11px; color: muted; overflow: elide; }
                Text { text: "Existing"; x: 8px; y: 116px; width: parent.width - 16px; height: 16px; font-size: 11px; color: muted; }
            }
            Rectangle {
                x: 32px + card-w;
                y: 48px;
                width: card-w;
                height: 146px;
                border-radius: 6px;
                border-width: 1px;
                border-color: hairline;
                Text { text: conflict-name; x: 8px; y: 6px; width: parent.width - 16px; height: 16px; font-size: 11px; color: text; overflow: elide; }
                if !live: Image {
                    x: 8px;
                    y: 26px;
                    width: 64px;
                    height: 64px;
                    source: @image-url("../assets/thumbs/dune-sunset-0413.jpg");
                    image-fit: cover;
                }
                if live: Text { text: conflict-incoming-folder ? "󰉋" : "󰈔"; x: 8px; y: 26px; width: 64px; height: 64px; font-size: 40px; color: muted; horizontal-alignment: center; vertical-alignment: center; }
                if conflict-incoming-badge != "": Rectangle { x: 8px; y: 94px; width: 52px; height: 14px; border-radius: 2px; background: accent; }
                if conflict-incoming-badge != "": Text { text: conflict-incoming-badge; x: 8px; y: 94px; width: 52px; height: 14px; font-size: 9px; font-weight: 700; color: on-accent; horizontal-alignment: center; vertical-alignment: center; }
                if conflict-incoming-badge2 != "": Rectangle { x: 64px; y: 94px; width: 52px; height: 14px; border-radius: 2px; background: accent; }
                if conflict-incoming-badge2 != "": Text { text: conflict-incoming-badge2; x: 64px; y: 94px; width: 52px; height: 14px; font-size: 9px; font-weight: 700; color: on-accent; horizontal-alignment: center; vertical-alignment: center; }
                Text { text: conflict-incoming-size; x: 80px; y: 28px; width: parent.width - 88px; height: 16px; font-size: 11px; color: muted; overflow: elide; }
                Text { text: conflict-incoming-date; x: 80px; y: 46px; width: parent.width - 88px; height: 16px; font-size: 11px; color: muted; overflow: elide; }
                Text { text: conflict-kind; x: 80px; y: 64px; width: parent.width - 88px; height: 16px; font-size: 11px; color: muted; overflow: elide; }
                Text { text: "Incoming"; x: 8px; y: 116px; width: parent.width - 16px; height: 16px; font-size: 11px; color: muted; }
            }
            Text {
                text: conflict-hint;
                x: 16px;
                y: 202px;
                width: parent.width - 32px;
                height: 16px;
                font-size: 11px;
                color: muted;
                overflow: elide;
            }
            // What Cancel doesn't take back, on its own line; 16px clear
            // of the right edge.
            Text {
                text: conflict-note;
                x: 16px;
                y: 220px;
                width: parent.width - 32px;
                height: 16px;
                font-size: 11px;
                color: muted;
                overflow: elide;
            }
            Rectangle {
                x: 16px;
                y: 246px;
                width: 14px;
                height: 14px;
                border-radius: 2px;
                border-color: f == 4 ? accent : line;
                border-width: f == 4 ? 2px : 1px;
                background: apply ? accent : transparent;
            }
            if apply: Text {
                text: "󰄬";
                x: 16px;
                y: 244px;
                width: 14px;
                height: 16px;
                font-size: 12px;
                color: on-accent;
                horizontal-alignment: center;
            }
            Text {
                text: conflict-apply-label;
                x: 36px;
                y: 244px;
                width: min(330px, parent.width - 52px);
                height: 18px;
                font-size: 12px;
                color: text;
                vertical-alignment: center;
                overflow: elide;
            }
            TouchArea { x: 12px; y: 240px; width: min(248px, parent.width - 24px); height: 26px; clicked => { root.dialog-button(4); } }
            if live: Rectangle {
                x: 16px;
                y: 280px;
                width: 88px;
                height: 32px;
                border-radius: 6px;
                border-width: f == 0 ? 2px : 1px;
                border-color: f == 0 ? accent : line;
                Text { text: "Cancel"; font-size: 12px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.dialog-button(0); } }
            }
            Rectangle {
                x: parent.width - 16px - 96px - 8px - 88px - 8px - 88px;
                y: 280px;
                width: 88px;
                height: 32px;
                border-radius: 6px;
                border-width: f == 1 ? 2px : 1px;
                border-color: f == 1 ? accent : line;
                Text { text: "Skip"; font-size: 12px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.dialog-button(1); } }
            }
            Rectangle {
                x: parent.width - 16px - 96px - 8px - 88px;
                y: 280px;
                width: 88px;
                height: 32px;
                border-radius: 6px;
                border-width: f == 2 ? 2px : 1px;
                border-color: f == 2 ? accent : line;
                Text { text: "Keep both"; font-size: 12px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.dialog-button(2); } }
            }
            Rectangle {
                x: parent.width - 16px - 96px;
                y: 280px;
                width: 96px;
                height: 32px;
                border-radius: 6px;
                // Primary: accent, or warning when the target is newer.
                background: conflict-replace-warn ? warning : accent;
                border-width: f == 3 ? 2px : 0px;
                border-color: text;
                Text { text: conflict-replace-label; font-size: 12px; color: conflict-replace-warn ? on-warning : on-accent; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.dialog-button(3); } }
            }
        }
    }

    if !harness && view-on: Rectangle {
        clip: true;
        background: #000000;
        // From 720 up the info panel docks and the picture fits beside it;
        // narrower, it floats over the picture between the top bar and the
        // toolbar. Mirrored by `app::info_dock`.
        property <bool> info-docked: self.width >= 720px;
        property <length> open-w: view-info && info-docked ? self.width - 332px : self.width;
        // The chrome's sizes, for keeping the HUD and minimap clear of it.
        property <length> bar-w: min(560px, open-w - 32px);
        property <length> tools-w: min(300px, open-w - 32px);
        property <length> strip-full: view-tiles.length * 76px + 8px;
        property <length> strip-w: min(strip-full, open-w - 32px);
        Rectangle { background: bg.with-alpha(0.30); }
        // Drags pan (the controller ignores them at fit); any move wakes
        // the chrome.
        TouchArea {
            property <length> last-x;
            property <length> last-y;
            mouse-cursor: view-scale > 0 ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    self.last-x = self.mouse-x;
                    self.last-y = self.mouse-y;
                }
            }
            moved => {
                root.view-pan((self.mouse-x - self.last-x) / 1px, (self.mouse-y - self.last-y) / 1px);
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
            }
            changed mouse-x => { root.view-wake(); }
            changed mouse-y => { root.view-wake(); }
        }
        // The pixel size is already turned (src/app.rs turns the pixels).
        // Stills never upscale past 100%; a playing video fills the window.
        property <float> fit-any: view-px-w <= 0 || view-px-h <= 0 ? 1 : min((open-w / 1px) / view-px-w, (self.height / 1px) / view-px-h);
        property <float> fit: view-playing ? fit-any : min(1, fit-any);
        property <float> drawn: view-scale > 0 ? view-scale : fit;
        Image {
            source: view-image;
            width: view-px-w * drawn * 1px;
            height: view-px-h * drawn * 1px;
            x: (open-w - self.width) / 2 + view-pan-x * 1px;
            y: (parent.height - self.height) / 2 + view-pan-y * 1px;
            image-fit: fill;
        }
        // The loading area stops above the filmstrip and below the top bar,
        // where a decoded picture at fit would sit.
        property <bool> strip-on: view-chrome && view-strip && view-tiles.length > 1;
        property <length> load-top: strip-on ? 64px : 0px;
        // Never negative: a window shorter than the strip shows no box.
        property <length> load-h: max(0px, strip-on ? self.height - 64px - 144px : self.height);
        if view-loading && view-placeholder.width > 0: Image {
            source: view-placeholder;
            x: 0px;
            y: load-top;
            width: open-w;
            height: load-h;
            image-fit: contain;
            image-rendering: smooth;
        }
        if view-loading && view-placeholder.width == 0: Rectangle {
            x: (open-w - self.width) / 2;
            y: load-top + (load-h - self.height) / 2;
            width: min(480px, open-w - 64px, max(0px, load-h - 32px) * 3 / 2);
            height: self.width * 2 / 3;
            border-radius: 6px;
            background: surface;
        }
        if view-spinner: Text {
            x: (open-w - self.width) / 2;
            y: load-top + (load-h - self.height) / 2;
            text: "󰔟";
            font-size: 22px;
            color: muted;
            rotation-angle: mod(animation-tick() / 1ms, 1000) / 1000 * 360deg;
        }
        if view-audio && view-note == "": VerticalLayout {
            x: 0px;
            width: open-w;
            alignment: center;
            spacing: 12px;
            Text { text: "󰎆"; font-size: 72px; color: muted; horizontal-alignment: center; }
            Text { text: view-name; font-size: 13px; color: text; horizontal-alignment: center; overflow: elide; }
        }
        if view-note != "": VerticalLayout {
            x: 0px;
            width: open-w;
            alignment: center;
            spacing: 10px;
            Text { text: view-audio ? "󰎆" : view-video ? "󰕧" : "󰈟"; font-size: 40px; color: muted; horizontal-alignment: center; }
            Text { text: view-note; font-size: 13px; color: muted; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: center;
                // Secondary: playing in Robin is the main path, this is
                // the way out when it can't.
                Rectangle {
                    width: 200px;
                    height: 34px;
                    border-radius: 6px;
                    background: ext-touch.has-hover ? hover : surface;
                    border-width: 1px;
                    border-color: hairline;
                    Text { text: "Open in default player"; font-size: 12px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                    ext-touch := TouchArea { mouse-cursor: pointer; clicked => { root.view-external(); } }
                }
            }
        }
        if view-chrome: Rectangle {
            y: 16px;
            x: (open-w - self.width) / 2;
            width: bar-w;
            height: 40px;
            background: bg.with-alpha(0.86);
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 12px;
                Text {
                    text: "󰁍"; font-size: 16px; color: text; vertical-alignment: center;
                    TouchArea { clicked => { root.view-close(); } }
                }
                Text { text: view-name; font-size: 13px; font-weight: 700; color: text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Text { text: view-counter; font-size: 11px; color: muted; vertical-alignment: center; }
