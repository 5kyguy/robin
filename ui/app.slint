                Rectangle { height: 12px; }
                Text { text: "CAMERA"; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; height: 20px; }
                MetaRow { key: "Model"; value: "Fujifilm X-T5"; ink: root.text; muted-ink: root.muted; }
                MetaRow { key: "Lens"; value: "XF 23mm F1.4"; ink: root.text; muted-ink: root.muted; }
                MetaRow { key: "ISO"; value: "160"; ink: root.text; muted-ink: root.muted; }
                MetaRow { key: "Aperture"; value: "f/8"; ink: root.text; muted-ink: root.muted; }
                MetaRow { key: "Shutter"; value: "1/500"; ink: root.text; muted-ink: root.muted; }
                MetaRow { key: "Focal"; value: "23 mm"; ink: root.text; muted-ink: root.muted; }
                Rectangle { height: 12px; }
                Text { text: "LOCATION"; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; height: 20px; }
                MetaRow { key: "Coords"; value: "33.98, 7.60"; ink: root.text; muted-ink: root.muted; }
            }
            }
        }
        if viewer == "zoom": Rectangle {
            x: parent.width - 16px - 120px;
            // Lifted above the filmstrip when a narrow window puts them
            // under each other.
            y: (open-w + strip-w) / 2 + 8px > self.x ? parent.height - 138px - 8px - 80px : parent.height - 16px - 80px;
            width: 120px;
            height: 80px;
            background: #000000;
            border-width: 1px;
            border-color: hairline;
            Image {
                source: @image-url("../assets/viewer/dune-sunset.png");
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
            Rectangle {
                x: (parent.width - 30px) / 2;
                y: (parent.height - 22px) / 2;
                width: 30px;
                height: 22px;
                border-width: 1px;
                border-color: accent;
            }
        }
        if viewer == "zoom": Rectangle {
            x: parent.width - 16px - 64px;
            y: 64px;
            width: 64px;
            height: 22px;
            background: bg.with-alpha(0.86);
            border-radius: 2px;
            border-width: 1px;
            border-color: hairline;
            Text { text: "400%"; font-size: 11px; color: text; horizontal-alignment: center; vertical-alignment: center; }
        }
        if viewer == "resume": Rectangle {
            width: min(280px, parent.width - 32px);
            x: (parent.width - self.width) / 2;
            y: parent.height - 194px;
            height: 40px;
            background: bg.with-alpha(0.86);
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            Text { text: "Resume at 02:14?"; font-size: 12px; color: text; horizontal-alignment: center; vertical-alignment: center; }
        }
        if viewer == "slideshow": Rectangle {
            y: parent.height - 2px;
            height: 2px;
            width: parent.width * 0.4;
            background: accent;
        }
    }

    if !harness && stats-mode != "": Rectangle {
        background: bg;
        x: side-w + 1px;
        width: parent.width - side-w - 1px;
        height: parent.height;
        property <length> pad: 20px;
        property <length> page-w: self.width;
        property <length> inner: page-w - pad * 2;
        // The treemap card keeps its 655 with FILE TYPES beside it while
        // that leaves FILE TYPES 300; narrower, FILE TYPES moves under it
        // and the treemap takes the full width. The page scrolls.
        property <bool> side-by-side: inner >= 655px + 12px + 300px;
        property <length> tree-w: side-by-side ? 655px : inner;
        property <length> map-w: tree-w - 32px;
        property <length> map-h: 300px;
        // The cells are laid out for 623×300 (app::map_cells) and
        // stretched across the card's width.
        property <float> map-k: map-w / 623px;
        property <length> disks-h: 44px + max(1, stat-disks.length) * 42px;
        property <length> mid-y: 48px + disks-h + 12px;
        property <length> mid-h: 356px;
        property <length> types-x: side-by-side ? pad + tree-w + 12px : pad;
        property <length> types-y: side-by-side ? mid-y : mid-y + mid-h + 12px;
        property <length> types-w: side-by-side ? inner - tree-w - 12px : inner;
        property <length> types-h: side-by-side ? mid-h : 68px + max(1, stat-types.length) * 24px + 8px;
        property <length> bot-y: types-y + types-h + 12px;
        // CACHE and TRASH sit side by side while each gets 360.
        property <bool> bot-pair: inner >= 360px * 2 + 12px;
        property <length> bot-w: bot-pair ? (inner - 12px) / 2 : inner;
        property <length> content-h: bot-y + (bot-pair ? 96px : 96px * 2 + 12px) + pad;
        Flickable {
        viewport-width: self.width;
        viewport-height: max(self.height, content-h);
        Text {
            text: "󰄨  Statistics";
            x: pad;
            y: 14px;
            width: 240px;
            height: 24px;
            font-size: 16px;
            font-weight: 700;
            color: text;
            vertical-alignment: center;
        }
        Text {
            text: stat-scanned;
            x: page-w - pad - self.width;
            y: 14px;
            width: max(0px, min(320px, inner - 150px));
            overflow: elide;
            height: 24px;
            font-size: 11px;
            color: muted;
            horizontal-alignment: right;
            vertical-alignment: center;
            visible: !stat-scanning;
            TouchArea { clicked => { root.stats-rescan(); } }
        }
        if stat-scanning: Rectangle {
            x: page-w - pad - self.width;
            y: 14px;
            width: max(0px, min(320px, inner - 150px));
            height: 24px;
            Text {
                text: "Scanning… " + stat-scan-count + " files";
                width: parent.width - 28px;
                overflow: elide;
                height: parent.height;
                font-size: 11px;
                color: muted;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Rectangle {
                x: parent.width - 20px;
                width: 20px;
                height: parent.height;
                border-radius: 4px;
                background: cancel-touch.has-hover ? hairline : transparent;
                Text { text: "×"; font-size: 13px; color: muted; horizontal-alignment: center; vertical-alignment: center; }
                cancel-touch := TouchArea { clicked => { root.stats-cancel(); } }
            }
        }
        Rectangle {
            x: pad;
            y: 48px;
            width: inner;
            height: disks-h;
            background: surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            Text { text: "DISKS"; x: 16px; y: 10px; width: 120px; height: 18px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; }
            if stat-disks.length == 0: Text { text: "Reading disks…"; x: 42px; y: 44px; width: 200px; height: 18px; font-size: 12px; color: muted; }
            for d[i] in stat-disks: Rectangle {
                x: 0px;
                y: 40px + i * 42px;
                width: parent.width;
                height: 36px;
                // Narrow: the free-space line moves under the bar, and the
                // bar takes the room the line had.
                property <bool> tight: self.width < 560px;
                property <length> meter-w: tight ? self.width - 160px - 16px - 72px - 8px : self.width - 160px - 280px;
                Text { text: "󰋊"; x: 16px; y: 0px; width: 18px; height: 36px; font-size: 14px; color: muted; vertical-alignment: center; }
                Text { text: d.name; x: 42px; y: -2px; width: 110px; height: 18px; font-size: 12px; color: text; overflow: elide; }
                Text { text: d.mount; x: 42px; y: 14px; width: 110px; height: 16px; font-size: 11px; color: muted; overflow: elide; }
                Meter {
                    x: 160px;
                    y: parent.tight ? 8px : 14px;
                    width: max(0px, parent.meter-w);
                    height: 8px;
                    amount: d.amount;
                    fill: d.level == 2 ? root.danger : d.level == 1 ? root.warning : root.accent;
                    track: root.text.with-alpha(0.12);
                }
                Text { text: d.pct; x: parent.tight ? parent.width - 16px - 72px : parent.width - 268px; y: -4px; width: 72px; height: 28px; font-size: 22px; font-weight: 700; color: text; horizontal-alignment: right; }
                Text { text: d.free; x: parent.tight ? 160px : parent.width - 188px; y: parent.tight ? 18px : 2px; width: parent.tight ? max(0px, parent.meter-w) : 172px; height: parent.tight ? 16px : 20px; font-size: 11px; color: muted; overflow: elide; }
            }
        }
        Rectangle {
            x: pad;
            y: mid-y;
            width: tree-w;
            height: mid-h;
            background: stat-has-results ? surface : transparent;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            if stat-scanning && !stat-has-results: Text { text: "Scanning…"; width: parent.width; height: parent.height; font-size: 12px; color: muted; horizontal-alignment: center; vertical-alignment: center; }
            Text {
                text: stat-tree-title;
                x: 16px;
                y: 10px;
                width: parent.width - 32px;
                height: 18px;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1px;
                color: muted;
            }
            if stat-skipped != "": Text {
                text: stat-skipped;
                x: 16px;
                y: 25px;
                width: parent.width - 32px;
                height: 14px;
                font-size: 10px;
                color: muted;
                overflow: elide;
                skipped-touch := TouchArea { }
                if skipped-touch.has-hover: Rectangle {
                    y: 16px;
                    z: 10;
                    width: min(420px, parent.width);
                    height: tip-text.preferred-height + 12px;
                    background: root.bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: hairline;
                    tip-text := Text { x: 8px; y: 6px; width: parent.width - 16px; text: stat-skipped-tip; font-size: 11px; color: text; wrap: word-wrap; }
                }
            }
            Rectangle {
                x: 16px;
                y: 40px;
                width: map-w;
                height: map-h;
                background: stat-has-results ? surface : transparent;
                for cell in map-cells: Rectangle {
                    x: cell.x * map-k;
                    y: cell.y;
                    width: cell.w * map-k;
                    height: cell.h;
                    background: root.accent.with-alpha(cell.shade);
                    border-radius: 3px;
                    border-width: cell.outline ? 1px : 0px;
                    border-color: root.accent;
                    property <bool> light: cell.shade >= 0.45;
                    property <color> label-ink: light ? root.on-accent : root.text;
                    property <color> detail-ink: light ? root.on-accent : root.muted;
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        property <bool> labeled: (cell.w * map-k >= 48px && cell.h >= 28px) || self.has-hover;
                        if labeled: Text {
                            text: cell.name;
                            x: 8px;
                            y: 6px;
                            width: parent.width - 16px;
                            height: 16px;
                            font-size: 12px;
                            color: label-ink;
                            overflow: elide;
                        }
                        if labeled && cell.h >= 42px: Text {
                            text: cell.detail;
                            x: 8px;
                            y: 22px;
                            width: parent.width - 16px;
                            height: 14px;
                            font-size: 11px;
                            color: detail-ink;
                            overflow: elide;
                        }
                    }
                }
            }
            if stat-scanning && stat-has-results: Rectangle { width: parent.width; height: parent.height; border-radius: 10px; background: root.bg.with-alpha(0.55); TouchArea { } }
        }
        Rectangle {
            x: types-x;
            y: types-y;
            width: types-w;
            height: types-h;
            background: stat-has-results ? surface : transparent;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            if stat-scanning && !stat-has-results: Text { text: "Scanning…"; width: parent.width; height: parent.height; font-size: 12px; color: muted; horizontal-alignment: center; vertical-alignment: center; }
            property <length> bw: self.width - 32px;
            Text { text: "FILE TYPES"; x: 16px; y: 10px; width: 160px; height: 18px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; }
            for t in stat-types: Rectangle { x: 16px + bw * t.start; y: 40px; width: bw * t.share; height: 16px; background: accent.with-alpha(t.alpha); }
            for t[i] in stat-types: TypeRow { x: 16px; y: 68px + i * 24px; width: parent.width - 32px; name: t.name; count: t.count; size: t.size; ink: root.text; muted-ink: root.muted; swatch: root.accent.with-alpha(t.alpha); }
            if stat-scanning && stat-has-results: Rectangle { width: parent.width; height: parent.height; border-radius: 10px; background: root.bg.with-alpha(0.55); TouchArea { } }
        }
        Rectangle {
            x: pad;
            y: bot-y;
            width: bot-w;
            height: 96px;
            background: stat-has-results ? surface : transparent;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            if stat-scanning && !stat-has-results: Text { text: "Scanning…"; width: parent.width; height: parent.height; font-size: 12px; color: muted; horizontal-alignment: center; vertical-alignment: center; }
            Text { text: "CACHE"; x: 16px; y: 12px; width: 80px; height: 16px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; }
            Text { text: stat-cache-total; x: 16px; y: 34px; width: 120px; height: 24px; font-size: 20px; font-weight: 700; color: text; }
            // Short labels, wrapping to a second line rather than cut off.
            Text { text: stat-cache-detail; x: 16px; y: 62px; width: parent.width - 32px - 188px; height: 30px; font-size: 11px; color: muted; wrap: word-wrap; overflow: elide; }
            Rectangle {
                visible: stat-has-results;
                x: parent.width - 16px - 180px;
                y: 32px;
                width: 180px;
                height: 32px;
                border-radius: 6px;
                border-width: 1px;
                border-color: line;
                Text { text: "Clear thumbnail cache"; font-size: 11px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.stats-clear-thumbs(); } }
            }
            if stat-scanning && stat-has-results: Rectangle { width: parent.width; height: parent.height; border-radius: 10px; background: root.bg.with-alpha(0.55); TouchArea { } }
        }
        Rectangle {
            x: bot-pair ? pad + bot-w + 12px : pad;
            y: bot-pair ? bot-y : bot-y + 96px + 12px;
            width: bot-w;
            height: 96px;
            background: stat-has-results ? surface : transparent;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            if stat-scanning && !stat-has-results: Text { text: "Scanning…"; width: parent.width; height: parent.height; font-size: 12px; color: muted; horizontal-alignment: center; vertical-alignment: center; }
            Text { text: "TRASH"; x: 16px; y: 12px; width: 80px; height: 16px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; }
            Text { text: stat-trash-size; x: 16px; y: 34px; width: parent.width - 32px - 140px; height: 24px; font-size: 20px; font-weight: 700; color: text; }
            // Under the size, as on the cache card.
            Text { text: stat-trash-count; x: 16px; y: 62px; width: parent.width - 32px - 140px; height: 18px; font-size: 11px; color: muted; overflow: elide; }
            Rectangle {
                visible: stat-has-results;
                x: parent.width - 16px - 112px;
                y: 32px;
                width: 112px;
                height: 32px;
                border-radius: 6px;
                // Outline danger, as in the Trash bar (#23): solid red is
                // kept for the confirm dialog.
                border-width: 1px;
                border-color: danger;
                background: trash-touch.has-hover ? danger.with-alpha(0.12) : transparent;
                Text { text: "Empty trash"; font-size: 12px; color: danger; horizontal-alignment: center; vertical-alignment: center; }
                // Opens the Trash, where emptying asks to confirm.
                trash-touch := TouchArea { clicked => { root.place-open(2, 0); } }
            }
            if stat-scanning && stat-has-results: Rectangle { width: parent.width; height: parent.height; border-radius: 10px; background: root.bg.with-alpha(0.55); TouchArea { } }
        }
        }
        if stats-mode == "empty-trash": Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #000000.with-alpha(0.6);
            Rectangle {
                width: min(440px, parent.width - 32px);
                height: min(220px, parent.height - 32px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: hairline;
                VerticalLayout {
                    padding: 20px;
                    padding-top: 24px;
                    spacing: 8px;
                    alignment: start;
                    Text { text: "󰀦  Permanently delete \{stat-trash-count} (\{stat-trash-size})?"; font-size: 13px; font-weight: 700; color: text; wrap: word-wrap; }
                    Text { text: "This can't be undone."; font-size: 12px; color: muted; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        height: 32px;
                        Rectangle {
                            width: 88px;
                            height: 32px;
                            border-radius: 6px;
                            border-width: 2px;
                            border-color: accent;
                            Text { text: "Cancel"; font-size: 12px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 168px;
                            height: 32px;
                            border-radius: 6px;
                            background: danger;
                            opacity: danger-armed ? 1 : 0.42;
                            Text { text: "Delete permanently"; font-size: 12px; color: on-danger; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 3px; background: danger; }
            }
        }
    }

    // Neutral completion toast. Skipped entries are listed, never dropped.
    if !harness && drag-label != "": Rectangle {
        width: min(drag-line.preferred-width + 58px, parent.width - side-w - 32px);
        height: 36px;
        x: side-w + (parent.width - side-w - self.width) / 2;
        y: parent.height - status-h - 16px - self.height;
        background: surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: accent;
        Text { text: drag-glyph; x: 14px; y: 0px; width: 18px; height: parent.height; font-size: 14px; color: accent; vertical-alignment: center; }
        drag-line := Text { text: drag-label; x: 40px; y: 0px; width: parent.width - 54px; height: parent.height; font-size: 12px; color: text; vertical-alignment: center; overflow: elide; }
    }

    // Only as tall as its rows: 28 each, at most 8, under the field.
    if !harness && overlay == "path-complete" && completions.length > 0: Rectangle {
        x: side-w + 1px + 8px + icon-box * 3 + 4px + 12px;
        y: toolbar-h - (toolbar-h - 30px) / 2 + 2px;
        width: min(360px, parent.width - self.x - 8px);
        height: min(8, completions.length) * 28px + 8px;
        background: surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: hairline;
        clip: true;
        VerticalLayout {
            padding: 4px;
            for c[i] in completions: Rectangle {
                height: 28px;
                visible: i < 8;
                border-radius: 6px;
                background: i == 0 ? selected : transparent;
                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 8px;
                    Text { text: "󰉋"; font-size: 14px; color: accent; vertical-alignment: center; }
                    Text { text: c; font-size: 12px; color: text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                }
            }
        }
    }
    // Above the browser and the viewer, so `?` works from either.
    if !harness && overlay == "shortcuts": Rectangle {
        background: #000000.with-alpha(0.6);
        Rectangle {
            // 760×520, or 16 clear of each window edge. Narrower than the
            // three columns need, the sections flow into two columns, then
            // one, and the list scrolls under the filter.
            width: min(760px, parent.width - 32px);
            height: min(520px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: bg.with-alpha(0.86);
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            clip: true;
            property <int> cols: self.width >= 700px ? 3 : self.width >= 420px ? 2 : 1;
            property <length> col-w: (self.width - 32px - (cols - 1) * 16px) / cols;
            // A section is its 20px header plus 22px rows, 4 apart.
            property <length> h0: key-sections.length > 0 ? 24px + key-sections[0].rows.length * 26px : 0px;
            property <length> h1: key-sections.length > 1 ? 24px + key-sections[1].rows.length * 26px : 0px;
            property <length> h2: key-sections.length > 2 ? 24px + key-sections[2].rows.length * 26px : 0px;
            property <length> list-h: cols == 3 ? max(h0, h1, h2) : cols == 2 ? max(h0, h1) + 16px + h2 : h0 + h1 + h2 + 32px;
            // The filter field across the top.
            Rectangle {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                height: 30px;
                border-radius: 6px;
                background: surface;
                border-width: 1px;
                border-color: hairline;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    Text { text: "󰍉"; font-size: 13px; color: muted; vertical-alignment: center; }
                    Text {
                        text: key-filter != "" ? key-filter : "Filter shortcuts";
                        font-size: 12px;
                        color: key-filter != "" ? text : muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text { text: "Esc"; font-size: 11px; color: muted; vertical-alignment: center; }
                }
            }
            Flickable {
                x: 16px;
                y: 62px;
                width: parent.width - 32px;
                height: max(0px, parent.height - 62px - 16px);
                viewport-width: self.width;
                viewport-height: list-h;
                for section[i] in key-sections: VerticalLayout {
                    x: cols == 3 ? i * (col-w + 16px) : cols == 2 ? Math.mod(i, 2) * (col-w + 16px) : 0px;
                    y: cols == 3 ? 0px
                        : cols == 2 ? (i >= 2 ? max(h0, h1) + 16px : 0px)
                        : (i == 0 ? 0px : i == 1 ? h0 + 16px : h0 + h1 + 32px);
                    width: col-w;
                    alignment: start;
                    spacing: 4px;
                    Text { text: section.title; height: 20px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; }
                    for row in section.rows: HorizontalLayout {
                        height: 22px;
                        spacing: 8px;
                        HorizontalLayout {
                            min-width: 92px;
                            spacing: 3px;
                            alignment: start;
                            for k in row.keys: KeyCap { key: k; ink: root.text; line-ink: root.line; y: 2px; }
                        }
                        Text { text: row.label; font-size: 11px; color: text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    }
                }
            }
        }
    }
}
