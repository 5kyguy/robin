            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            HorizontalLayout {
                alignment: center;
                spacing: parent.width < 300px ? 10px : 18px;
                for k in [{g: "󰁍", k: "h"}, {g: "−", k: "-"}, {g: "fit", k: "0"}, {g: "1:1", k: "1"}, {g: "+", k: "+"}, {g: "󰑙", k: "r"}, {g: "󰁔", k: "l"}]: Text {
