        if viewer == "info": Rectangle {
            x: parent.width - 16px - 300px;
            y: 72px;
            width: 300px;
            height: parent.height - 88px;
            background: bg.with-alpha(0.92);
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            VerticalLayout {
                padding: 16px;
                spacing: 0px;
                alignment: start;
                Text { text: "dune-sunset-0412.jpg"; font-size: 13px; font-weight: 700; color: text; height: 20px; }
                Text { text: "~/Pictures/tatooine-trip"; font-size: 11px; color: muted; height: 18px; }
                Rectangle { height: 12px; }
                Text { text: "FILE"; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; height: 20px; }
                MetaRow { key: "Size"; value: "6.2 MB"; ink: root.text; muted-ink: root.muted; }
                MetaRow { key: "Type"; value: "JPEG"; ink: root.text; muted-ink: root.muted; }
                MetaRow { key: "Dimensions"; value: "6000 × 4000"; ink: root.text; muted-ink: root.muted; }
                MetaRow { key: "Modified"; value: "2026-10-30 15:41"; ink: root.text; muted-ink: root.muted; }
                Rectangle { height: 12px; }
                Text { text: "CAMERA"; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; height: 20px; }
                MetaRow { key: "Model"; value: "Fujifilm X-T5"; ink: root.text; muted-ink: root.muted; }
                MetaRow { key: "Lens"; value: "XF 23mm F1.4"; ink: root.text; muted-ink: root.muted; }
                MetaRow { key: "ISO"; value: "160"; ink: root.text; muted-ink: root.muted; }
                MetaRow { key: "Aperture"; value: "f/8"; ink: root.text; muted-ink: root.muted; }
                MetaRow { key: "Shutter"; value: "1/500"; ink: root.text; muted-ink: root.muted; }
                MetaRow { key: "Focal"; value: "23 mm"; ink: root.text; muted-ink: root.muted; }
                Rectangle { height: 12px; }
                Text { text: "LOCATION"; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; height: 20px; }
                MetaRow { key: "Coords"; value: "33.98, 7.60"; ink: root.text; muted-ink: root.muted; }
            }
        }
        if viewer == "zoom": Rectangle {
            x: parent.width - 16px - 120px;
            y: parent.height - 16px - 80px;
            width: 120px;
            height: 80px;
            background: #000000;
            border-width: 1px;
            border-color: hairline;
            Image {
                source: @image-url("../assets/viewer/dune-sunset.png");
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
            Rectangle {
                x: (parent.width - 30px) / 2;
                y: (parent.height - 22px) / 2;
                width: 30px;
                height: 22px;
                border-width: 1px;
                border-color: accent;
            }
        }
        if viewer == "zoom": Rectangle {
            x: parent.width - 16px - 64px;
            y: 64px;
            width: 64px;
            height: 22px;
            background: bg.with-alpha(0.86);
            border-radius: 2px;
            border-width: 1px;
            border-color: hairline;
            Text { text: "400%"; font-size: 11px; color: text; horizontal-alignment: center; vertical-alignment: center; }
        }
        if viewer == "resume": Rectangle {
            x: (parent.width - 280px) / 2;
            y: parent.height - 194px;
            width: 280px;
            height: 40px;
            background: bg.with-alpha(0.86);
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            Text { text: "Resume at 02:14?"; font-size: 12px; color: text; horizontal-alignment: center; vertical-alignment: center; }
        }
        if viewer == "slideshow": Rectangle {
            y: parent.height - 2px;
            height: 2px;
            width: parent.width * 0.4;
            background: accent;
        }
    }

    if !harness && stats-mode != "": Rectangle {
        background: bg;
        x: side-w + 1px;
        width: parent.width - side-w - 1px;
        height: parent.height;
        property <length> pad: 20px;
        property <length> tree-w: 655px;
        property <length> map-w: 623px;
        property <length> map-h: 300px;
        property <length> mid-y: 188px;
        property <length> mid-h: 356px;
        property <length> bot-y: 556px;
        Text {
            text: "󰄨  Statistics";
            x: pad;
            y: 14px;
            width: 240px;
            height: 24px;
            font-size: 16px;
            font-weight: 700;
            color: text;
            vertical-alignment: center;
        }
        Text {
            text: "Scanned 2026-10-30 18:58  ·  Rescan";
            x: parent.width - pad - 320px;
            y: 14px;
            width: 320px;
            height: 24px;
            font-size: 11px;
            color: muted;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle {
            x: pad;
            y: 48px;
            width: parent.width - pad * 2;
            height: 128px;
            background: surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            Text { text: "DISKS"; x: 16px; y: 10px; width: 120px; height: 18px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; }
            Text { text: "󰋊"; x: 16px; y: 40px; width: 18px; height: 36px; font-size: 14px; color: muted; vertical-alignment: center; }
            Text { text: "r2-root"; x: 42px; y: 38px; width: 120px; height: 18px; font-size: 12px; color: text; }
            Text { text: "/"; x: 42px; y: 54px; width: 120px; height: 16px; font-size: 11px; color: muted; }
            Meter {
                x: 160px;
                y: 54px;
                width: parent.width - 160px - 280px;
                height: 8px;
                amount: 0.58;
                fill: root.accent;
                track: root.text.with-alpha(0.12);
            }
            Text { text: "58%"; x: parent.width - 268px; y: 36px; width: 72px; height: 28px; font-size: 22px; font-weight: 700; color: text; horizontal-alignment: right; }
            Text { text: "812 GB free of 1.8 TB"; x: parent.width - 188px; y: 42px; width: 172px; height: 20px; font-size: 11px; color: muted; }
            Text { text: "󰋊"; x: 16px; y: 82px; width: 18px; height: 36px; font-size: 14px; color: muted; vertical-alignment: center; }
            Text { text: "archive"; x: 42px; y: 80px; width: 120px; height: 18px; font-size: 12px; color: text; }
            Text { text: "/mnt/archive"; x: 42px; y: 96px; width: 120px; height: 16px; font-size: 11px; color: muted; }
            Meter {
                x: 160px;
                y: 96px;
                width: parent.width - 160px - 280px;
                height: 8px;
                amount: 0.91;
                fill: root.warning;
                track: root.text.with-alpha(0.12);
            }
            Text { text: "91%"; x: parent.width - 268px; y: 78px; width: 72px; height: 28px; font-size: 22px; font-weight: 700; color: text; horizontal-alignment: right; }
            Text { text: "362 GB free of 4 TB"; x: parent.width - 188px; y: 84px; width: 172px; height: 20px; font-size: 11px; color: muted; }
        }
        Rectangle {
            x: pad;
            y: mid-y;
            width: tree-w;
            height: mid-h;
            background: surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            Text {
                text: stats-mode == "drilled" ? "LARGEST FOLDERS   ›   Videos" : "LARGEST FOLDERS";
                x: 16px;
                y: 10px;
                width: parent.width - 32px;
                height: 18px;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1px;
                color: muted;
            }
            Rectangle {
                x: 16px;
                y: 40px;
                width: map-w;
                height: map-h;
                background: surface;
                for cell in map-cells: Rectangle {
                    x: cell.x;
                    y: cell.y;
                    width: cell.w;
                    height: cell.h;
                    background: root.accent.with-alpha(cell.shade);
                    border-radius: 3px;
                    property <bool> light: cell.shade >= 0.45;
                    property <color> label-ink: light ? root.on-accent : root.text;
                    property <color> detail-ink: light ? root.on-accent : root.muted;
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        property <bool> labeled: (cell.w >= 48px && cell.h >= 28px) || self.has-hover;
                        if labeled: Text {
                            text: cell.name;
                            x: 8px;
                            y: 6px;
                            width: parent.width - 16px;
                            height: 16px;
                            font-size: 12px;
                            color: label-ink;
                            overflow: elide;
                        }
                        if labeled && cell.h >= 42px: Text {
                            text: cell.detail;
                            x: 8px;
                            y: 22px;
                            width: parent.width - 16px;
                            height: 14px;
                            font-size: 11px;
                            color: detail-ink;
                            overflow: elide;
                        }
                    }
                }
            }
        }
        Rectangle {
            x: pad + tree-w + 12px;
            y: mid-y;
            width: parent.width - pad - tree-w - 12px - pad;
            height: mid-h;
            background: surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            property <length> bw: self.width - 32px;
            Text { text: "FILE TYPES"; x: 16px; y: 10px; width: 160px; height: 18px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; }
            Rectangle { x: 16px; y: 40px; width: bw * 0.395; height: 16px; background: accent; }
            Rectangle { x: 16px + bw * 0.395; y: 40px; width: bw * 0.156; height: 16px; background: accent.with-alpha(0.80); }
            Rectangle { x: 16px + bw * 0.551; y: 40px; width: bw * 0.155; height: 16px; background: accent.with-alpha(0.60); }
            Rectangle { x: 16px + bw * 0.706; y: 40px; width: bw * 0.084; height: 16px; background: accent.with-alpha(0.45); }
            Rectangle { x: 16px + bw * 0.790; y: 40px; width: bw * 0.056; height: 16px; background: accent.with-alpha(0.32); }
            Rectangle { x: 16px + bw * 0.846; y: 40px; width: bw * 0.030; height: 16px; background: accent.with-alpha(0.20); }
            Rectangle { x: 16px + bw * 0.876; y: 40px; width: bw * 0.124; height: 16px; background: accent.with-alpha(0.10); }
            TypeRow { x: 16px; y: 68px; width: parent.width - 32px; name: "Video"; count: "1 840"; size: "412 GB"; ink: root.text; muted-ink: root.muted; swatch: root.accent; }
            TypeRow { x: 16px; y: 92px; width: parent.width - 32px; name: "Images"; count: "48 210"; size: "163 GB"; ink: root.text; muted-ink: root.muted; swatch: root.accent.with-alpha(0.80); }
            TypeRow { x: 16px; y: 116px; width: parent.width - 32px; name: "Code"; count: "312 064"; size: "162 GB"; ink: root.text; muted-ink: root.muted; swatch: root.accent.with-alpha(0.60); }
            TypeRow { x: 16px; y: 140px; width: parent.width - 32px; name: "Archives"; count: "612"; size: "88 GB"; ink: root.text; muted-ink: root.muted; swatch: root.accent.with-alpha(0.45); }
            TypeRow { x: 16px; y: 164px; width: parent.width - 32px; name: "Audio"; count: "6 120"; size: "58 GB"; ink: root.text; muted-ink: root.muted; swatch: root.accent.with-alpha(0.32); }
            TypeRow { x: 16px; y: 188px; width: parent.width - 32px; name: "Docs"; count: "9 870"; size: "31 GB"; ink: root.text; muted-ink: root.muted; swatch: root.accent.with-alpha(0.20); }
            TypeRow { x: 16px; y: 212px; width: parent.width - 32px; name: "Other"; count: "—"; size: "128 GB"; ink: root.text; muted-ink: root.muted; swatch: root.accent.with-alpha(0.10); }
        }
        Rectangle {
            x: pad;
            y: bot-y;
            width: (parent.width - pad * 2 - 12px) / 2;
            height: 96px;
            background: surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            Text { text: "CACHE"; x: 16px; y: 12px; width: 80px; height: 16px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; }
            Text { text: "1.4 GB"; x: 16px; y: 34px; width: 90px; height: 24px; font-size: 20px; font-weight: 700; color: text; }
            Text { text: "212 MB thumbs · 38 MB mpv"; x: 16px; y: 66px; width: parent.width - 32px - 188px; height: 18px; font-size: 11px; color: muted; overflow: elide; }
            Rectangle {
                x: parent.width - 16px - 180px;
                y: 32px;
                width: 180px;
                height: 32px;
                border-radius: 6px;
                border-width: 1px;
                border-color: line;
                Text { text: "Clear thumbnail cache"; font-size: 11px; color: text; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        Rectangle {
            x: pad + (parent.width - pad * 2 - 12px) / 2 + 12px;
            y: bot-y;
            width: (parent.width - pad * 2 - 12px) / 2;
            height: 96px;
            background: surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            Text { text: "TRASH"; x: 16px; y: 12px; width: 80px; height: 16px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; }
            Text { text: "4.7 GB"; x: 16px; y: 36px; width: 90px; height: 28px; font-size: 20px; font-weight: 700; color: text; }
            Text { text: "2 318 items"; x: 110px; y: 42px; width: 120px; height: 18px; font-size: 11px; color: muted; }
            Rectangle {
                x: parent.width - 16px - 112px;
                y: 32px;
                width: 112px;
                height: 32px;
                border-radius: 6px;
                background: danger;
                Text { text: "Empty trash"; font-size: 12px; color: on-danger; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
        if stats-mode == "empty-trash": Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: #000000.with-alpha(0.6);
            Rectangle {
                width: 440px;
                height: 220px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: surface;
                border-radius: 10px;
                border-width: 1px;
                border-color: hairline;
                VerticalLayout {
                    padding: 20px;
                    padding-top: 24px;
                    spacing: 8px;
                    alignment: start;
                    Text { text: "󰀦  Permanently delete 2 318 items (4.7 GB)?"; font-size: 13px; font-weight: 700; color: text; wrap: word-wrap; }
                    Text { text: "This can't be undone."; font-size: 12px; color: muted; }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        height: 32px;
                        Rectangle {
                            width: 88px;
                            height: 32px;
                            border-radius: 6px;
                            border-width: 2px;
                            border-color: accent;
                            Text { text: "Cancel"; font-size: 12px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 168px;
                            height: 32px;
                            border-radius: 6px;
                            background: danger;
                            opacity: 0.42;
                            Text { text: "Delete permanently"; font-size: 12px; color: on-danger; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 3px; background: danger; }
            }
        }
    }

    // Neutral completion toast. Skipped entries are listed, never dropped.
    if !harness && drag-label != "": Rectangle {
        width: drag-line.preferred-width + 58px;
        height: 36px;
        x: side-w + (parent.width - side-w - self.width) / 2;
        y: parent.height - status-h - 16px - self.height;
        background: surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: accent;
        Text { text: drag-glyph; x: 14px; y: 0px; width: 18px; height: parent.height; font-size: 14px; color: accent; vertical-alignment: center; }
        drag-line := Text { text: drag-label; x: 40px; y: 0px; height: parent.height; font-size: 12px; color: text; vertical-alignment: center; }
    }

    if !harness && overlay == "path-complete": Rectangle {
        x: side-w + 120px;
        y: toolbar-h;
        width: 360px;
        background: surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: hairline;
        VerticalLayout {
            Text { text: "Pictures"; height: 28px; font-size: 12px; color: text; vertical-alignment: center; }
            Text { text: "Projects"; height: 28px; font-size: 12px; color: text; vertical-alignment: center; }
            Text { text: "Public"; height: 28px; font-size: 12px; color: text; vertical-alignment: center; }
        }
    }
}
