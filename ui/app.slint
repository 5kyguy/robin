import "../assets/fonts/JetBrainsMonoNerdFont-Regular.ttf";
import "../assets/fonts/JetBrainsMonoNerdFont-Bold.ttf";
import "../assets/fonts/JetBrainsMonoNerdFont-Medium.ttf";
import { ListView } from "std-widgets.slint";

export struct Place {
    glyph: string,
    name: string,
    count: string,
    selected: bool,
    usage: float,
    level: int,
    section: int,
}

export struct Row {
    glyph: string,
    name: string,
    size: string,
    kind: string,
    modified: string,
    selected: bool,
    hovered: bool,
    hidden: bool,
    role: int,
    badge: string,
}

export struct GridLine {
    n: int,
    g0: string, n0: string, r0: int, b0: string, s0: bool, h0: bool,
    g1: string, n1: string, r1: int, b1: string, s1: bool, h1: bool,
    g2: string, n2: string, r2: int, b2: string, s2: bool, h2: bool,
    g3: string, n3: string, r3: int, b3: string, s3: bool, h3: bool,
    g4: string, n4: string, r4: int, b4: string, s4: bool, h4: bool,
    g5: string, n5: string, r5: int, b5: string, s5: bool, h5: bool,
}

component Tile inherits Rectangle {
    in property <string> glyph;
    in property <string> name;
    in property <int> role;
    in property <string> badge;
    in property <bool> picked;
    in property <bool> hot;
    in property <length> tile;
    in property <color> ink;
    in property <color> accent;
    in property <color> danger;
    in property <color> warning;
    in property <color> muted;
    in property <color> surface;
    in property <color> selected-bg;
    in property <color> hover-bg;
    width: tile;
    height: tile + 28px;
    border-radius: 6px;
    background: picked ? selected-bg : hot ? hover-bg : transparent;
    VerticalLayout {
        padding: 6px;
        alignment: center;
        Rectangle {
            width: tile - 12px;
            height: tile - 12px;
            border-radius: 4px;
            background: surface;
            Text {
                text: glyph;
                font-size: tile * 0.32;
                color: role == 2 ? danger : role == 3 ? warning : role == 1 ? accent : role == 4 ? muted : ink;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if badge != "": Text {
                text: badge;
                y: 4px;
                x: 4px;
                font-size: 9px;
                font-weight: 600;
                color: ink;
            }
        }
        Text {
            text: name;
            font-size: 12px;
            color: ink;
            horizontal-alignment: center;
            overflow: elide;
            height: 16px;
        }
    }
}

export component AppWindow inherits Window {
    property <length> row-h: compact ? 24px : 30px;
    in property <bool> harness: true;
    in property <color> bg: #061216;
    in property <color> surface: #0e1e26;
    in property <color> text: #e7fbff;
    in property <color> muted: #7ec8d4;
    in property <color> accent: #00e5ff;
    in property <color> on-accent: #042028;
    in property <color> line: #1e6a78;
    in property <color> danger: #ff2a4a;
    in property <color> on-danger: #fff5f6;
    in property <color> warning: #ffb000;
    in property <color> on-warning: #1a1200;
    in property <string> label: "Robin";
    in property <bool> compact: false;
    in property <bool> grid: false;
    in property <bool> collapsed: false;
    in property <length> tile: 152px;
    in property <string> state: "files";
    in property <string> overlay: "";
    in property <string> status-left: "15 items · 1 hidden";
    in property <string> status-right: "812 GB free of 1.8 TB";
    in property <bool> hidden-on: false;
    in property <string> crumbs: "~  ›  Pictures";
    in property <string> path-text: "/home/sky/Pictures";
    in property <string> search-query: "";
    in property <string> search-count: "";
    in property <string> dialog-title: "";
    in property <string> dialog-body: "";
    in property <[Place]> places;
    in property <[Row]> files;
    in property <[GridLine]> grid-rows;
    in property <[string]> menu-labels;

    title: "Robin";
    default-font-family: "JetBrainsMono Nerd Font";
    default-font-size: 12px;
    background: bg;

    property <length> side-row: compact ? 26px : 30px;
    property <length> toolbar-h: compact ? 40px : 46px;
    property <length> icon-box: compact ? 28px : 34px;
    property <length> status-h: compact ? 22px : 26px;
    property <length> side-w: collapsed ? 52px : 232px;
    property <color> hairline: text.with-alpha(0.12);
    property <color> hover: text.with-alpha(0.06);
    property <color> selected: accent.with-alpha(0.18);
    property <color> selected-active: accent.with-alpha(0.28);
    property <color> divider: line;

    if harness: VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;
        Text { text: "󰋜"; font-size: 14px; color: accent; }
        Text { text: label; font-size: 18px; font-weight: 700; color: text; }
        Text { text: "in development"; font-size: 11px; color: muted; }
        Rectangle {
            background: surface;
            height: 30px;
            border-radius: 6px;
            border-width: 1px;
            border-color: hairline;
            HorizontalLayout {
                padding-left: 8px;
                Text { text: label; font-size: 12px; color: text; vertical-alignment: center; }
            }
        }
    }

    if !harness: HorizontalLayout {
        Rectangle {
            width: side-w;
            background: surface;
            VerticalLayout {
                padding: 8px;
                spacing: 2px;
                if !collapsed: Text {
                    text: "PINNED";
                    height: 24px;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 1px;
                    color: muted;
                    vertical-alignment: center;
                }
                for place in places: Rectangle {
                    visible: place.section == 0;
                    height: side-row;
                    border-radius: 6px;
                    background: place.selected ? selected : transparent;
                    border-width: place.selected ? 1px : 0px;
                    border-color: accent;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;
                        alignment: center;
                        Rectangle {
                            width: 18px;
                            height: 18px;
                            Text {
                                text: place.glyph;
                                font-size: 14px;
                                color: muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if !collapsed: Text {
                            text: place.name;
                            font-size: 12px;
                            color: text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if !collapsed: Text {
                            text: place.count;
                            font-size: 11px;
                            color: muted;
                            vertical-alignment: center;
                        }
                    }
                }
                if !collapsed: Text {
                    text: "DEVICES";
                    height: 24px;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 1px;
                    color: muted;
                    vertical-alignment: center;
                }
                for place in places: VerticalLayout {
                    visible: place.section == 1;
                    spacing: 0;
                    Rectangle {
                        height: side-row;
                        border-radius: 6px;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 8px;
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                Text {
                                    text: place.glyph;
                                    font-size: 14px;
                                    color: muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            if !collapsed: Text {
                                text: place.name;
                                font-size: 12px;
                                color: text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            if !collapsed: Text {
                                text: place.count;
                                font-size: 11px;
                                color: muted;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if !collapsed && place.usage >= 0: Rectangle {
                        x: 0;
                        height: 3px;
                        border-radius: 2px;
                        background: text.with-alpha(0.12);
                        Rectangle {
                            width: parent.width * place.usage;
                            height: 3px;
                            border-radius: 2px;
                            background: place.level == 2 ? danger : place.level == 1 ? warning : accent;
                        }
                    }
                }
                if !collapsed: Text {
                    text: "TRASH";
                    height: 24px;
                    font-size: 11px;
                    font-weight: 700;
                    letter-spacing: 1px;
                    color: muted;
                    vertical-alignment: center;
                }
                for place in places: Rectangle {
                    visible: place.section == 2;
                    height: side-row;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 8px;
                        Rectangle {
                            width: 18px;
                            height: 18px;
                            Text {
                                text: place.glyph;
                                font-size: 14px;
                                color: muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if !collapsed: Text {
                            text: place.name;
                            font-size: 12px;
                            color: text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if !collapsed: Text {
                            text: place.count;
                            font-size: 11px;
                            color: muted;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    height: side-row;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding-left: 6px;
                        spacing: 8px;
                        Rectangle {
                            width: 18px;
                            height: 18px;
                            Text {
                                text: "󰄨";
                                font-size: 14px;
                                color: muted;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if !collapsed: Text {
                            text: "Statistics";
                            font-size: 12px;
                            color: text;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        Rectangle { width: 1px; background: divider; }
        VerticalLayout {
            Rectangle {
                height: toolbar-h;
                background: bg;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 2px;
                    alignment: center;
                    toolbar-icon := Rectangle {
                        width: icon-box;
                        height: icon-box;
                        border-radius: 3px;
                        Text { text: "󰁍"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: icon-box;
                        height: icon-box;
                        border-radius: 3px;
                        Text { text: "󰁔"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: icon-box;
                        height: icon-box;
                        border-radius: 3px;
                        Text { text: "󰁝"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle { width: 12px; }
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 30px;
                        border-radius: 6px;
                        background: surface;
                        border-width: overlay == "path-invalid" ? 2px : 1px;
                        border-color: overlay == "path-invalid" ? danger : overlay == "path-edit" ? accent : hairline;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            if overlay != "search" && overlay != "path-edit" && overlay != "path-invalid" && overlay != "path-complete": Text {
                                text: crumbs;
                                font-size: 12px;
                                color: muted;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if overlay == "search": Text {
                                text: search-query;
                                font-size: 12px;
                                color: text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            if overlay == "search": Text {
                                text: search-count;
                                font-size: 11px;
                                color: muted;
                                vertical-alignment: center;
                            }
                            if overlay == "path-edit" || overlay == "path-invalid" || overlay == "path-complete": Text {
                                text: path-text;
                                font-size: 12px;
                                color: text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    Rectangle { width: 12px; }
                    Rectangle {
                        width: icon-box;
                        height: icon-box;
                        border-radius: 3px;
                        Text { text: "󰍉"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 1px;
                        height: 20px;
                        background: text.with-alpha(0.14);
                    }
                    Rectangle {
                        width: icon-box;
                        height: icon-box;
                        border-radius: 3px;
                        background: !grid ? selected : transparent;
                        Text { text: "󰈚"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: icon-box;
                        height: icon-box;
                        border-radius: 3px;
                        background: grid ? selected : transparent;
                        Text { text: "󰕰"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: icon-box;
                        height: icon-box;
                        border-radius: 3px;
                        Text { text: "󰇘"; font-size: 16px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
            Rectangle { height: 1px; background: divider; }

            Rectangle {
                vertical-stretch: 1;
                background: bg;
                if state == "files" && !grid: VerticalLayout {
                    Rectangle {
                        height: 26px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            Text { text: "NAME  󰁝"; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: accent; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Text { text: "SIZE"; width: 88px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; horizontal-alignment: right; vertical-alignment: center; }
                            Text { text: "TYPE"; width: 120px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; vertical-alignment: center; overflow: elide; }
                            Text { text: "MODIFIED"; width: 140px; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; vertical-alignment: center; }
                        }
                    }
                    Rectangle { height: 1px; background: divider; }
                    ListView {
                        vertical-stretch: 1;
                        for row in files: Rectangle {
                            height: row-h;
                            background: row.selected ? selected-active : row.hovered ? hover : transparent;
                            border-radius: 6px;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                alignment: center;
                                Text {
                                    text: row.glyph;
                                    font-size: 14px;
                                    color: row.role == 2 ? danger : row.role == 3 ? warning : row.role == 1 ? accent : row.role == 4 ? muted : text;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: row.name;
                                    font-size: 12px;
                                    font-weight: row.selected ? 700 : 400;
                                    color: text;
                                    opacity: row.hidden ? 0.6 : 1;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text { text: row.size; width: 88px; font-size: 12px; color: muted; horizontal-alignment: right; vertical-alignment: center; }
                                Text { text: row.kind; width: 120px; font-size: 12px; color: muted; vertical-alignment: center; }
                                Text { text: row.modified; width: 140px; font-size: 12px; color: muted; vertical-alignment: center; }
                            }
                        }
                    }
                }
                if state == "files" && grid: ListView {
                    vertical-stretch: 1;
                    for line in grid-rows: HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        height: tile + 36px;
                        if line.n > 0: Tile {
                            glyph: line.g0; name: line.n0; role: line.r0; badge: line.b0; picked: line.s0; hot: line.h0;
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 1: Tile {
                            glyph: line.g1; name: line.n1; role: line.r1; badge: line.b1; picked: line.s1; hot: line.h1;
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 2: Tile {
                            glyph: line.g2; name: line.n2; role: line.r2; badge: line.b2; picked: line.s2; hot: line.h2;
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 3: Tile {
                            glyph: line.g3; name: line.n3; role: line.r3; badge: line.b3; picked: line.s3; hot: line.h3;
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 4: Tile {
                            glyph: line.g4; name: line.n4; role: line.r4; badge: line.b4; picked: line.s4; hot: line.h4;
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                        if line.n > 5: Tile {
                            glyph: line.g5; name: line.n5; role: line.r5; badge: line.b5; picked: line.s5; hot: line.h5;
                            tile: root.tile; ink: root.text; accent: root.accent; danger: root.danger; warning: root.warning; muted: root.muted; surface: root.surface; selected-bg: root.selected; hover-bg: root.hover;
                        }
                    }
                }
                if state == "empty" || state == "denied" || state == "unmounted" || state == "ejected" || state == "nosearch" || state == "loading": VerticalLayout {
                    alignment: center;
                    Text {
                        text: state == "empty" ? "󰉖" : state == "denied" ? "󰌾" : state == "nosearch" ? "󰍉" : state == "loading" ? "" : "󰕓";
                        font-size: 64px;
                        color: state == "denied" || state == "ejected" ? warning.with-alpha(0.6) : muted.with-alpha(0.6);
                        horizontal-alignment: center;
                    }
                    Rectangle { height: 12px; }
                    Text {
                        text: state == "empty" ? "This folder is empty" : state == "denied" ? "No permission to open ~/secret" : state == "unmounted" ? "SANDISK is not mounted" : state == "ejected" ? "SANDISK was removed" : state == "nosearch" ? "Nothing matches \"kotlin\"" : "Reading…";
                        font-size: 18px;
                        font-weight: 700;
                        color: text;
                        horizontal-alignment: center;
                    }
                    Rectangle { height: 6px; }
                    Text {
                        text: state == "empty" ? "Drop files here or press Ctrl+N" : state == "denied" ? "Owned by root (drwx------)" : state == "nosearch" ? "Searched 4 812 items in ~/Projects" : state == "loading" ? "18 240 items" : "";
                        font-size: 11px;
                        color: muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        width: 360px;
                    }
                }
            }

            if overlay == "progress-1" || overlay == "progress-3" || overlay == "progress-error": Rectangle {
                height: overlay == "progress-3" ? 116px : 44px;
                background: surface;
                VerticalLayout {
                    Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            alignment: center;
                            Text { text: "󰆏"; font-size: 16px; color: accent; }
                            Text { text: "Copying 1 204 files to SANDISK"; font-size: 12px; color: text; }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 4px;
                                border-radius: 2px;
                                background: text.with-alpha(0.12);
                                Rectangle {
                                    width: parent.width * (overlay == "progress-error" ? 0.4 : 0.33);
                                    height: 4px;
                                    background: overlay == "progress-error" ? danger : accent;
                                    border-radius: 2px;
                                }
                            }
                            Text { text: "2.1 / 6.4 GB · 84 MB/s · 52s left"; font-size: 11px; color: muted; }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: divider; }
            Rectangle {
                height: status-h;
                background: bg;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    alignment: center;
                    Text { text: status-left; font-size: 11px; color: muted; vertical-alignment: center; horizontal-stretch: 1; }
                    Text { text: status-right; font-size: 11px; color: muted; vertical-alignment: center; }
                    Rectangle { width: 8px; }
                    Text { text: "󰈈"; font-size: 14px; color: hidden-on ? accent : muted; vertical-alignment: center; }
                }
            }
        }
    }

    if !harness && (overlay == "trash" || overlay == "trash-no" || overlay == "delete" || overlay == "menu-file" || overlay == "shortcuts"): Rectangle {
        background: #000000.with-alpha(0.6);
        if overlay == "delete" || overlay == "trash" || overlay == "trash-no": Rectangle {
            width: 440px;
            height: overlay == "delete" ? 220px : 200px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            if overlay == "delete": Rectangle {
                height: 3px;
                background: danger;
                border-radius: 10px;
            }
            VerticalLayout {
                padding: 20px;
                spacing: 8px;
                if overlay == "delete": Text { text: "󰀦  Permanently delete 3 items?"; font-size: 13px; font-weight: 700; color: text; }
                if overlay != "delete": Text {
                    text: overlay == "trash-no" ? "This drive has no trash" : "Move 3 items to trash?";
                    font-size: 13px;
                    font-weight: 700;
                    color: text;
                }
                Text {
                    text: overlay == "delete" ? "This can't be undone." : overlay == "trash-no" ? "Robin will not copy these files home." : "You can restore them from Trash.";
                    font-size: 12px;
                    color: muted;
                }
                Text { text: "dune-sunset-0412.jpg\ndune-sunset-0413.jpg\nspeeder-run.mp4"; font-size: 11px; color: muted; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Rectangle {
                        width: 88px;
                        height: 32px;
                        border-radius: 6px;
                        border-width: overlay == "delete" ? 2px : 1px;
                        border-color: overlay == "delete" ? accent : line;
                        Text { text: "Cancel"; font-size: 12px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        min-width: 88px;
                        height: 32px;
                        border-radius: 6px;
                        background: overlay == "delete" || overlay == "trash-no" ? danger : accent;
                        opacity: overlay == "delete" ? 0.42 : 1;
                        Text {
                            text: overlay == "delete" || overlay == "trash-no" ? "Delete permanently" : "Move to Trash";
                            font-size: 12px;
                            color: overlay == "delete" || overlay == "trash-no" ? on-danger : on-accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        if overlay == "menu-file": Rectangle {
            x: 280px;
            y: 220px;
            width: 220px;
            background: surface;
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            VerticalLayout {
                padding: 4px;
                for label in menu-labels: Text {
                    text: label;
                    height: 28px;
                    font-size: 12px;
                    color: label == "Delete permanently" ? danger : text;
                    vertical-alignment: center;
                }
            }
        }
        if overlay == "shortcuts": Rectangle {
            width: 760px;
            height: 520px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: bg.with-alpha(0.86);
            border-radius: 10px;
            border-width: 1px;
            border-color: hairline;
            VerticalLayout {
                padding: 16px;
                spacing: 8px;
                Text { text: "SHORTCUTS"; font-size: 11px; font-weight: 700; letter-spacing: 1px; color: muted; }
                Text { text: "h l    previous / next"; font-size: 12px; color: text; }
                Text { text: "F2     rename"; font-size: 12px; color: text; }
                Text { text: "Del    move to trash"; font-size: 12px; color: text; }
                Text { text: "Ctrl+H show hidden"; font-size: 12px; color: text; }
            }
        }
    }

    if !harness && overlay == "path-complete": Rectangle {
        x: side-w + 120px;
        y: toolbar-h;
        width: 360px;
        background: surface;
        border-radius: 6px;
        border-width: 1px;
        border-color: hairline;
        VerticalLayout {
            Text { text: "Pictures"; height: 28px; font-size: 12px; color: text; vertical-alignment: center; }
            Text { text: "Projects"; height: 28px; font-size: 12px; color: text; vertical-alignment: center; }
            Text { text: "Public"; height: 28px; font-size: 12px; color: text; vertical-alignment: center; }
        }
    }
}
