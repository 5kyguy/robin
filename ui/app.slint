                Text {
                    text: refusal-body != "" ? refusal-body : refusal-can-copy ? refusal-lines-items > 1 ? "Robin can copy them there instead and leave the originals where they are." : "Robin can copy it there instead and leave the original where it is." : "Nothing was moved.";
                    font-size: 12px;
                    color: muted;
                    wrap: word-wrap;
                }
