                        width: 88px;
                        height: 32px;
                        border-radius: 6px;
                        border-width: dialog-focus == 0 ? 2px : 1px;
                        border-color: dialog-focus == 0 ? accent : line;
                        Text { text: refusal-dismiss; font-size: 12px; color: text; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.dialog-button(0); } }
                    }
                    // Default button: filled, with the focus ring.
                    if refusal-can-copy: Rectangle {
                        width: 112px;
                        height: 32px;
                        border-radius: 6px;
                        background: accent;
                        border-width: dialog-focus == 1 ? 2px : 0px;
