                if view-playing: Text {
                    text: "󰏌"; font-size: 16px; width: 20px; color: open-touch.has-hover ? accent : text; vertical-alignment: center;
                    open-touch := TouchArea { mouse-cursor: pointer; clicked => { root.view-external(); } }
                }
                Text {
                    text: "󰋽"; font-size: 16px; width: 20px; color: view-info ? accent : text; vertical-alignment: center;
                    TouchArea { clicked => { root.view-key("i"); } }
                }
            }
        }
        if view-chrome && view-strip && view-tiles.length > 1: Rectangle {
