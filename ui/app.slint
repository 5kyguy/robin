import "../assets/fonts/JetBrainsMonoNerdFont-Regular.ttf";
import "../assets/fonts/JetBrainsMonoNerdFont-Bold.ttf";
import "../assets/fonts/JetBrainsMonoNerdFont-Medium.ttf";

// Harness window. Browser, viewer, and statistics replace this layout.
// Colors arrive from Rust. The defaults are the cyan reference so a missed
// binding is still on-palette.
export component AppWindow inherits Window {
    in property <color> bg: #061216;
    in property <color> surface: #0e1e26;
    in property <color> text: #e7fbff;
    in property <color> muted: #7ec8d4;
    in property <color> accent: #00e5ff;
    in property <color> on-accent: #042028;
    in property <string> label: "Robin";
    title: "Robin";
    default-font-family: "JetBrainsMono Nerd Font";
    default-font-size: 12px;
    background: bg;

    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: start;

        Text {
            text: "󰋜";
            font-size: 14px;
            color: accent;
        }

        Text {
            text: label;
            font-size: 18px;
            font-weight: 700;
            color: text;
        }

        Text {
            text: "in development";
            font-size: 11px;
            color: muted;
        }

        Rectangle {
            background: surface;
            height: 30px;
            border-radius: 6px;
            border-width: 1px;
            border-color: text.with-alpha(0.12);
            HorizontalLayout {
                padding-left: 8px;
                alignment: start;
                Text {
                    text: label;
                    font-size: 12px;
                    color: text;
                    vertical-alignment: center;
                }
            }
        }
    }
}
